{
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["host", "database", "user", "scratchDatabase"],
    "properties": {
      "host": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)$",
        "errorMessage": "Enter a hostname or a dotted-decimal IPv4 address without a scheme, port or path."
      },
      "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8443 },
      "database": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "errorMessage": "Use letters, digits and underscores, start with a letter or underscore, at most 128 characters."
      },
      "user": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "errorMessage": "Use letters, digits and underscores, start with a letter or underscore, at most 128 characters."
      },
      "secure": { "type": "boolean", "const": true, "default": true },
      "skipVerify": { "type": "boolean", "const": false, "default": false },
      "scratchDatabase": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "errorMessage": "Use letters, digits and underscores, start with a letter or underscore, at most 128 characters."
      }
    }
  },
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["password"],
    "properties": {
      "password": {
        "type": "string",
        "pattern": "^[^\\x00-\\x20\\x7F-\\xA0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF]([^\\x00-\\x1F\\x7F-\\x9F]*[^\\x00-\\x20\\x7F-\\xA0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF])?$",
        "errorMessage": "The password cannot contain control characters or start or end with whitespace."
      }
    }
  }
}
