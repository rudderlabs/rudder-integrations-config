{
  "uiConfig": [
    {
      "title": "Connection Credentials",
      "docLinks": {
        "setupInstructions": "https://www.rudderstack.com/docs/sources/reverse-etl/sftp",
        "jsonMapperUseInstructions": "https://www.rudderstack.com/docs/sources/reverse-etl/sftp/#specifying-the-data-to-import"
      },
      "nameField": "username",
      "secretFields": ["password", "privateKey", "privateKeyPassphrase"],
      "fields": [
        {
          "type": "textInput",
          "label": "Host",
          "note": "Hostname or IP address of the SFTP server. Do not include the port number.",
          "value": "host",
          "regex": "^[A-Za-z0-9.\\-]{1,255}$",
          "regexErrorMessage": "Invalid Host",
          "required": true,
          "placeholder": "e.g: sftp.example.com",
          "addInAccountSummary": true,
          "trim": true
        },
        {
          "type": "textInput",
          "label": "Port",
          "value": "port",
          "regex": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "regexErrorMessage": "Port must be between 1 and 65535",
          "inputFieldType": "number",
          "required": true,
          "default": 22,
          "placeholder": "e.g: 22"
        },
        {
          "type": "textInput",
          "label": "Username",
          "value": "username",
          "regex": "^.{1,100}$",
          "regexErrorMessage": "Invalid Username",
          "required": true,
          "placeholder": "e.g: testUser",
          "addInAccountSummary": true,
          "trim": true
        },
        {
          "type": "singleSelect",
          "label": "Authentication",
          "note": "Select the authentication method.",
          "value": "authMethod",
          "options": [
            {
              "name": "Username + SSH Key (recommended)",
              "value": "keyAuth"
            },
            {
              "name": "Username + Password",
              "value": "passwordAuth"
            }
          ],
          "defaultOption": {
            "value": "keyAuth"
          }
        },
        {
          "type": "textInput",
          "label": "Password",
          "value": "password",
          "regex": "^.{1,100}$",
          "regexErrorMessage": "Invalid Password",
          "inputFieldType": "password",
          "required": true,
          "secret": true,
          "preRequisiteField": {
            "name": "authMethod",
            "selectedValue": "passwordAuth"
          }
        },
        {
          "type": "textareaInput",
          "label": "Private Key",
          "note": "Enter the full private key for the user, including the header and footer lines.",
          "value": "privateKey",
          "regex": "^[\\s\\S]+$",
          "regexErrorMessage": "Invalid Private Key",
          "required": true,
          "secret": true,
          "preRequisiteField": {
            "name": "authMethod",
            "selectedValue": "keyAuth"
          }
        },
        {
          "type": "textInput",
          "label": "Private Key Passphrase",
          "note": "Only required if the private key is encrypted. Leave blank otherwise.",
          "value": "privateKeyPassphrase",
          "regex": "^.{0,200}$",
          "regexErrorMessage": "Invalid Passphrase",
          "inputFieldType": "password",
          "required": false,
          "secret": true,
          "preRequisiteField": {
            "name": "authMethod",
            "selectedValue": "keyAuth"
          }
        }
      ]
    }
  ]
}
