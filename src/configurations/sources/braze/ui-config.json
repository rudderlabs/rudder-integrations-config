{
  "uiConfig": [
    {
      "title": "Connection Settings",
      "fields": [
        {
          "type": "dynamicForm",
          "label": "Map Braze Event Names To Custom Event Names",
          "value": "customMapping",
          "required": false,
          "keyLeft": "from",
          "keyRight": "to",
          "placeholderLeft": "e.g. users.messages.inappmessage.Click",
          "placeholderRight": "e.g. In-App Message Clicked",
          "labelLeft": "Braze Event Name",
          "labelRight": "Source Transformed Event Name"
        }
      ]
    },
    {
      "title": "Event Filtering",
      "sectionNote": "Drop high-volume Braze event types before they enter your pipeline. Use either an allowlist or a denylist, not both.",
      "fields": [
        {
          "type": "singleSelect",
          "label": "Event filtering option",
          "value": "eventFilteringOption",
          "required": false,
          "options": [
            { "name": "Disable", "value": "disable" },
            { "name": "Allowlist", "value": "whitelistedEvents" },
            { "name": "Denylist", "value": "blacklistedEvents" }
          ],
          "defaultOption": { "name": "Disable", "value": "disable" }
        },
        {
          "type": "dynamicCustomForm",
          "value": "whitelistedEvents",
          "label": "Allowlist",
          "preRequisiteField": {
            "name": "eventFilteringOption",
            "selectedValue": "whitelistedEvents"
          },
          "customFields": [
            {
              "type": "textInput",
              "value": "eventName",
              "required": false,
              "placeholder": "e.g. users.messages.email.Open"
            }
          ],
          "footerNote": "Only these Braze event types are ingested. Enter the raw Braze event_type exactly as Braze sends it. Leave empty to ingest everything."
        },
        {
          "type": "dynamicCustomForm",
          "value": "blacklistedEvents",
          "label": "Denylist",
          "preRequisiteField": {
            "name": "eventFilteringOption",
            "selectedValue": "blacklistedEvents"
          },
          "customFields": [
            {
              "type": "textInput",
              "value": "eventName",
              "required": false,
              "placeholder": "e.g. users.messages.email.Open"
            }
          ],
          "footerNote": "These Braze event types are dropped at the source. Enter the raw Braze event_type exactly as Braze sends it."
        }
      ]
    }
  ]
}
