{
  "uiConfig": [
    {
      "title": "Connection Credentials",
      "secretFields": ["credentials"],
      "docLinks": {
        "grantPermissions": "https://docs.rudderstack.com/reverse-etl/google-bigquery/#granting-permissions",
        "verifyingCredentials": "https://docs.rudderstack.com/reverse-etl/google-bigquery/#what-do-the-three-validations-under-verifying-credentials-imply",
        "jsonMapperUseInstructions": "https://docs.rudderstack.com/reverse-etl/google-bigquery/#specifying-the-data-to-import",
        "setupInstructions": "https://docs.rudderstack.com/reverse-etl/google-bigquery"
      },
      "schemaAlias": "Dataset",
      "nameField": "project",
      "fields": [
        {
          "type": "singleSelect",
          "label": "Authentication Method",
          "value": "authMethod",
          "options": [
            {
              "name": "Service Account Key",
              "value": "serviceAccountKey"
            },
            {
              "name": "Workload Identity Federation",
              "value": "workloadIdentityFederation"
            }
          ],
          "defaultOption": {
            "name": "Service Account Key",
            "value": "serviceAccountKey"
          },
          "required": false,
          "footerNote": "Workload Identity Federation authenticates through a pool in your GCP project that trusts RudderStack's AWS account. Scope the GCP trust grant to assumed-role/data-plane-service-account/<workspaceID> (replace <workspaceID> with your RudderStack workspace ID), not the whole role. You can optionally impersonate your service account, so no key is stored",
          "preRequisiteFeatureFlag": "AMP_enable-bigquery-workload-identity-federation"
        },
        {
          "type": "textareaInput",
          "subType": "JSON",
          "label": "Credentials",
          "labelNote": "GCP Service Account credentials JSON for RudderStack to use in loading data into your BigQuery database",
          "value": "credentials",
          "regex": ".*",
          "required": true,
          "secret": true,
          "preRequisites": {
            "fields": [
              {
                "configKey": "authMethod",
                "value": "serviceAccountKey"
              }
            ],
            "featureFlags": [
              {
                "configKey": "AMP_enable-bigquery-workload-identity-federation"
              }
            ],
            "prerequisitesCondition": "or"
          }
        },
        {
          "type": "textInput",
          "label": "Project ID",
          "labelNote": "GCP Project ID where your BigQuery database is located.",
          "value": "project",
          "regex": "^(.{0,100})$",
          "regexErrorMessage": "Invalid Value",
          "required": true,
          "infoTooltip": "The project_id of the GCP project that holds your BigQuery data.",
          "addInAccountSummary": true
        },
        {
          "type": "textInput",
          "label": "Service account",
          "value": "serviceAccount",
          "regex": "^(.{0,100})$",
          "regexErrorMessage": "Enter a valid email address",
          "required": true,
          "infoTooltip": "Inferred from client_email field in the credentials settings.",
          "addInAccountSummary": true,
          "readOnly": true,
          "obtainValueFromField": {
            "name": "credentials",
            "key": "client_email"
          },
          "preRequisites": {
            "fields": [
              {
                "configKey": "authMethod",
                "value": "serviceAccountKey"
              }
            ],
            "featureFlags": [
              {
                "configKey": "AMP_enable-bigquery-workload-identity-federation"
              }
            ],
            "prerequisitesCondition": "or"
          }
        },
        {
          "type": "textInput",
          "preRequisiteField": [
            {
              "name": "authMethod",
              "selectedValue": "workloadIdentityFederation"
            }
          ],
          "label": "Workload Identity Pool Project Number",
          "value": "workloadIdentityProjectNumber",
          "preRequisiteFeatureFlag": "AMP_enable-bigquery-workload-identity-federation",
          "regex": "^[0-9]{1,20}$",
          "regexErrorMessage": "Project number must contain only digits. Use the project number, not the project ID.",
          "placeholder": "e.g: 123456789012",
          "required": true
        },
        {
          "type": "textInput",
          "preRequisiteField": [
            {
              "name": "authMethod",
              "selectedValue": "workloadIdentityFederation"
            }
          ],
          "label": "Workload Identity Pool ID",
          "value": "workloadIdentityPoolId",
          "preRequisiteFeatureFlag": "AMP_enable-bigquery-workload-identity-federation",
          "regex": "^(?!gcp-)[a-z0-9-]{4,32}$",
          "regexErrorMessage": "Pool ID must be 4-32 lowercase letters, numbers or hyphens, and cannot start with gcp-.",
          "placeholder": "e.g: rudderstack-pool",
          "required": true
        },
        {
          "type": "textInput",
          "preRequisiteField": [
            {
              "name": "authMethod",
              "selectedValue": "workloadIdentityFederation"
            }
          ],
          "label": "Workload Identity Provider ID",
          "value": "workloadIdentityProviderId",
          "preRequisiteFeatureFlag": "AMP_enable-bigquery-workload-identity-federation",
          "regex": "^(?!gcp-)[a-z0-9-]{4,32}$",
          "regexErrorMessage": "Provider ID must be 4-32 lowercase letters, numbers or hyphens, and cannot start with gcp-.",
          "placeholder": "e.g: rudderstack-aws",
          "required": true
        },
        {
          "type": "textInput",
          "preRequisiteField": [
            {
              "name": "authMethod",
              "selectedValue": "workloadIdentityFederation"
            }
          ],
          "label": "Target Service Account",
          "value": "workloadIdentityTargetServiceAccount",
          "preRequisiteFeatureFlag": "AMP_enable-bigquery-workload-identity-federation",
          "regex": "^$|^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$",
          "regexErrorMessage": "Target service account must be a service account email ending in .iam.gserviceaccount.com.",
          "placeholder": "e.g: rudderstack@my-project.iam.gserviceaccount.com",
          "required": false,
          "footerNote": "Required only for service account impersonation. Leave empty if you use federated identities."
        }
      ]
    }
  ]
}
