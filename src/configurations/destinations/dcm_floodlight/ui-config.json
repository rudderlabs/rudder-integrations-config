{
  "uiConfig": {
    "baseTemplate": [
      {
        "title": "Initial setup",
        "note": "Review how this destination is set up",
        "sections": [
          {
            "groups": [
              {
                "title": "Connection settings",
                "note": "Update your connection settings here",
                "icon": "settings",
                "fields": [
                  {
                    "type": "textInput",
                    "label": "DoubleClick Advertiser ID",
                    "configKey": "advertiserId",
                    "regex": "^([0-9]{0,100})$",
                    "regexErrorMessage": "Enter an advertiser ID using numbers only",
                    "required": true,
                    "placeholder": "e.g. 22XXX552",
                    "secret": true,
                    "note": "Enter your Floodlight advertiser ID by going to the Campaigns or Activities tab in your dashboard."
                  }
                ]
              }
            ]
          },
          {
            "groups": [
              {
                "title": "Connection mode",
                "note": [
                  "Update how you want to route events from your source to destination. ",
                  {
                    "text": "Get help deciding",
                    "link": "https://www.rudderstack.com/docs/destinations/rudderstack-connection-modes/"
                  }
                ],
                "icon": "sliders",
                "fields": []
              }
            ]
          }
        ]
      },
      {
        "title": "Event mapping",
        "note": "Map RudderStack events to Floodlight conversions",
        "hideEditIcon": true,
        "sections": [
          {
            "groups": [
              {
                "title": "Conversion events",
                "fields": [
                  {
                    "type": "redirect",
                    "redirectGroupKey": "conversionEvents",
                    "label": "Conversion events",
                    "note": "Map RudderStack events to Floodlight tags and custom variables"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Configuration settings",
        "note": "Manage the settings for your destination",
        "sections": [
          {
            "title": "Destination settings",
            "note": "Configure advanced destination-specific settings here",
            "icon": "settings",
            "groups": [
              {
                "title": "Floodlight tag defaults",
                "note": "Fallback tag values used when a conversion event mapping leaves them blank",
                "fields": [
                  {
                    "type": "textInput",
                    "label": "Activity Tag",
                    "configKey": "activityTag",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "regexErrorMessage": "Activity tag must be 100 characters or less",
                    "required": false,
                    "placeholder": "e.g. signu0",
                    "secret": false,
                    "note": "Default Floodlight activity tag (cat) for all conversion events. A Floodlight Activity Tag set on a conversion event mapping takes precedence."
                  },
                  {
                    "type": "textInput",
                    "label": "Group Tag",
                    "configKey": "groupTag",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "regexErrorMessage": "Group tag must be 100 characters or less",
                    "required": false,
                    "placeholder": "e.g. conv01",
                    "secret": false,
                    "note": "Default Floodlight group tag (type) for all conversion events. A Floodlight Group Tag set on a conversion event mapping takes precedence."
                  },
                  {
                    "type": "textInput",
                    "label": "Counting Method",
                    "configKey": "countingMethod",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "regexErrorMessage": "Counting method must be 100 characters or less",
                    "required": false,
                    "placeholder": "e.g. standard",
                    "secret": false,
                    "note": "Default Floodlight counting method for all conversion events. A Floodlight Counting Method set on a conversion event mapping takes precedence."
                  }
                ]
              }
            ]
          },
          {
            "id": "consentSettings",
            "title": "Consent settings",
            "note": "Configure consent settings for each provider here",
            "icon": "settings",
            "groups": []
          },
          {
            "title": "Other settings",
            "note": "Configure advanced RudderStack features here",
            "icon": "otherSettings",
            "groups": [
              {
                "title": "Client-side event filtering",
                "note": "Decide what events are allowed (allowlisting) and blocked (denylisting)",
                "preRequisites": {
                  "fields": [
                    {
                      "configKey": "connectionMode.web",
                      "value": "device"
                    }
                  ]
                },
                "fields": [
                  {
                    "type": "singleSelect",
                    "label": "Choose if you want to turn on events filtering:",
                    "configKey": "eventFilteringOption",
                    "note": "You must select either allowlist or denylist to enable events filtering",
                    "options": [
                      {
                        "label": "Disabled",
                        "value": "disable"
                      },
                      {
                        "label": "Filter via allowlist",
                        "value": "whitelistedEvents"
                      },
                      {
                        "label": "Filter via denylist",
                        "value": "blacklistedEvents"
                      }
                    ],
                    "default": "disable"
                  },
                  {
                    "type": "tagInput",
                    "label": "Allowlisted events",
                    "note": "Input separate events by pressing 'Enter'.\nInput the events you want to allowlist.",
                    "configKey": "whitelistedEvents",
                    "tagKey": "eventName",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "placeholder": "e.g: Anonymous Page Visit",
                    "default": [
                      {
                        "eventName": ""
                      }
                    ],
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "eventFilteringOption",
                          "value": "whitelistedEvents"
                        }
                      ]
                    }
                  },
                  {
                    "type": "tagInput",
                    "label": "Denylisted events",
                    "note": "Input separate events by pressing 'Enter'.\nInput the events you want to denylist.",
                    "configKey": "blacklistedEvents",
                    "tagKey": "eventName",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "placeholder": "e.g: Credit Card Added",
                    "default": [
                      {
                        "eventName": ""
                      }
                    ],
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "eventFilteringOption",
                          "value": "blacklistedEvents"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "sdkTemplate": {
      "title": "SDK settings",
      "note": "not visible in the ui",
      "fields": [
        {
          "type": "singleSelect",
          "label": "Tag Format",
          "note": "Choose how the Floodlight tag loads on your site: the global site tag (gtag.js) or an iframe tag.",
          "configKey": "tagFormat",
          "required": false,
          "options": [
            {
              "label": "Global site tag",
              "value": "globalSiteTag"
            },
            {
              "label": "Iframe tag",
              "value": "iframeTag"
            }
          ],
          "default": "globalSiteTag"
        },
        {
          "type": "checkbox",
          "label": "Conversion Linker",
          "note": "Store ad click information in first-party cookies so conversions can be attributed to ad clicks. Applies to the global site tag only.",
          "configKey": "conversionLinker",
          "default": true
        },
        {
          "type": "checkbox",
          "label": "Allow ad personalization signals",
          "note": "Turn off to stop data from this site being used for ad personalization. Applies to the global site tag only.",
          "configKey": "allowAdPersonalizationSignals",
          "default": true
        },
        {
          "type": "checkbox",
          "label": "DoubleClick Id",
          "note": "Enable Google cookie matching using the RudderStack anonymous ID. Requires Google Network ID.",
          "configKey": "doubleclickId",
          "default": false
        },
        {
          "type": "textInput",
          "label": "Google Network Id",
          "configKey": "googleNetworkId",
          "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
          "regexErrorMessage": "Network ID must be 100 characters or less",
          "required": false,
          "note": "Network ID (NID) for the bidder account. Required for cookie matching when DoubleClick Id is enabled."
        }
      ]
    },
    "consentSettingsTemplate": {
      "title": "Consent settings",
      "note": "not visible in the ui",
      "fields": [
        {
          "type": "dynamicCustomForm",
          "configKey": "consentManagement",
          "default": [],
          "rowFields": [
            {
              "type": "singleSelect",
              "label": "Consent management provider",
              "configKey": "provider",
              "options": [
                {
                  "label": "Custom",
                  "value": "custom"
                },
                {
                  "label": "Ketch",
                  "value": "ketch"
                },
                {
                  "label": "OneTrust",
                  "value": "oneTrust"
                },
                {
                  "label": "iubenda",
                  "value": "iubenda"
                }
              ],
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "the required consent logic",
              "configKey": "resolutionStrategy",
              "options": [
                {
                  "label": "AND",
                  "value": "and"
                },
                {
                  "label": "OR",
                  "value": "or"
                }
              ],
              "required": true,
              "variant": "badge",
              "preRequisites": {
                "fields": [
                  {
                    "configKey": "provider",
                    "value": "custom"
                  }
                ]
              }
            },
            {
              "type": "tagInput",
              "label": "Enter consent category IDs",
              "note": "Input your consent category IDs by pressing 'Enter' after each entry. We recommend using IDs instead of names as IDs are unique and less likely to change over time, making them a more reliable choice.",
              "configKey": "consents",
              "tagKey": "consent",
              "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
              "placeholder": "e.g: Marketing",
              "default": [
                {
                  "consent": ""
                }
              ]
            }
          ],
          "uniqueRowFields": ["provider"]
        }
      ]
    },
    "redirectGroups": {
      "conversionEvents": {
        "fields": [
          {
            "type": "dynamicCustomForm",
            "label": "Conversion events",
            "note": "Only events with a conversion event mapping are sent to Floodlight in cloud mode.",
            "configKey": "conversionEvents",
            "default": [],
            "addButtonLabel": "Add conversion event",
            "rowFields": [
              {
                "type": "textInput",
                "label": "Rudderstack Event Name",
                "configKey": "eventName",
                "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                "regexErrorMessage": "Event name must be 100 characters or less",
                "required": false,
                "placeholder": "e.g: Product Viewed",
                "note": "RudderStack event name to send as this conversion, matched case-insensitively. For page calls, use the form 'Viewed <category> <name> Page'."
              },
              {
                "type": "textInput",
                "label": "Floodlight Activity Tag",
                "configKey": "floodlightActivityTag",
                "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                "regexErrorMessage": "Activity tag must be 100 characters or less",
                "required": false,
                "placeholder": "e.g: signu0",
                "note": "The activity tag (cat) of your tag string. If blank, RudderStack uses the Activity Tag from Configuration settings."
              },
              {
                "type": "textInput",
                "label": "Floodlight Group Tag",
                "configKey": "floodlightGroupTag",
                "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                "regexErrorMessage": "Group tag must be 100 characters or less",
                "required": false,
                "placeholder": "e.g: conv01",
                "note": "The group tag (type) of your tag string. If blank, RudderStack uses the Group Tag from Configuration settings."
              },
              {
                "type": "textInput",
                "label": "Floodlight Counting Method",
                "configKey": "floodlightCountingMethod",
                "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                "regexErrorMessage": "Counting method must be 100 characters or less",
                "required": false,
                "placeholder": "e.g: standard",
                "note": "Counting method for this conversion event. RudderStack uses it as a fallback when properties.countingMethod is empty."
              },
              {
                "type": "checkbox",
                "label": "Fire as Sales Tag",
                "configKey": "salesTag",
                "default": false,
                "note": "Enable this toggle if the tag is a Sales tag. Keep it disabled if the tag is a Counter tag."
              },
              {
                "type": "mapping",
                "label": "Use this section to map the RudderStack event properties to custom Floodlight variables.",
                "configKey": "customVariables",
                "note": "Map RudderStack event properties (left) to Floodlight custom variable numbers such as 1, 2, 3 (right).",
                "columns": [
                  {
                    "type": "textInput",
                    "label": "Rudderstack properties",
                    "configKey": "from",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "regexErrorMessage": "Property name must be 100 characters or less",
                    "placeholder": "e.g. Rudderstack property"
                  },
                  {
                    "type": "textInput",
                    "label": "Floodlight Custom Variables",
                    "configKey": "to",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "regexErrorMessage": "Custom variable must be 100 characters or less",
                    "placeholder": "eg: 1"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
