{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "^(.{1,500})$"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["pixelId"],
    "properties": {
      "pixelId": {
        "type": "string",
        "pattern": "^(.{1,200})$"
      }
    }
  }
}
