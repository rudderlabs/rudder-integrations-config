{
  "name": "OPENAI_ADS",
  "displayName": "OpenAI Ads",
  "version": "1.0",
  "config": {
    "supportedAccountDefinitions": {
      "rudderAccountId": ["DESTINATION_OPENAI_ADS_API_KEY"]
    },
    "transformAtV1": "router",
    "saveDestinationResponse": true,
    "includeKeys": [
      "useNativeSDK",
      "connectionMode",
      "consentManagement",
      "defaultActionSource",
      "defaultCurrency",
      "eventMapping",
      "eventFilteringOption",
      "whitelistedEvents",
      "blacklistedEvents"
    ],
    "excludeKeys": [],
    "supportedSourceTypes": [
      "android",
      "androidKotlin",
      "ios",
      "iosSwift",
      "web",
      "unity",
      "amp",
      "cloud",
      "reactnative",
      "flutter",
      "cordova",
      "shopify"
    ],
    "supportedMessageTypes": {
      "cloud": ["track", "page", "screen"],
      "device": {
        "web": ["identify", "track", "page", "screen"]
      }
    },
    "supportedConnectionModes": {
      "android": ["cloud"],
      "androidKotlin": ["cloud"],
      "ios": ["cloud"],
      "iosSwift": ["cloud"],
      "web": ["cloud", "device"],
      "unity": ["cloud"],
      "amp": ["cloud"],
      "reactnative": ["cloud"],
      "flutter": ["cloud"],
      "cordova": ["cloud"],
      "shopify": ["cloud"],
      "cloud": ["cloud"]
    },
    "destConfig": {
      "defaultConfig": [
        "rudderAccountId",
        "pixelId",
        "apiKey",
        "defaultActionSource",
        "defaultCurrency",
        "eventMapping"
      ],
      "web": [
        "useNativeSDK",
        "connectionMode",
        "consentManagement",
        "eventFilteringOption",
        "whitelistedEvents",
        "blacklistedEvents"
      ],
      "cloud": ["connectionMode", "consentManagement"],
      "android": ["connectionMode", "consentManagement"],
      "androidKotlin": ["connectionMode", "consentManagement"],
      "ios": ["connectionMode", "consentManagement"],
      "iosSwift": ["connectionMode", "consentManagement"],
      "unity": ["connectionMode", "consentManagement"],
      "amp": ["connectionMode", "consentManagement"],
      "reactnative": ["connectionMode", "consentManagement"],
      "flutter": ["connectionMode", "consentManagement"],
      "cordova": ["connectionMode", "consentManagement"],
      "shopify": ["connectionMode", "consentManagement"]
    },
    "secretKeys": ["apiKey"]
  },
  "options": {
    "hidden": {
      "gate": {
        "flags": [{ "name": "AMP_enable-openai-ads-destination", "value": false }]
      }
    }
  }
}
