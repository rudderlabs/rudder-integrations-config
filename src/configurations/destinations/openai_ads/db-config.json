{
  "name": "OPENAI_ADS",
  "displayName": "OpenAI Ads",
  "version": "1.0",
  "config": {
    "transformAtV1": "router",
    "saveDestinationResponse": true,
    "includeKeys": [
      "apiKey",
      "defaultCurrency",
      "defaultActionSource",
      "eventMapping",
      "useNativeSDK",
      "connectionMode",
      "consentManagement"
    ],
    "excludeKeys": ["apiKey"],
    "supportedSourceTypes": ["cloud", "web"],
    "supportedConnectionModes": {
      "cloud": ["cloud"],
      "web": ["cloud", "device"]
    },
    "supportedMessageTypes": {
      "cloud": ["track", "page", "screen"],
      "device": {
        "web": ["identify", "track", "page", "screen"]
      }
    },
    "destConfig": {
      "defaultConfig": ["apiKey", "defaultCurrency", "defaultActionSource", "eventMapping"],
      "cloud": ["connectionMode", "consentManagement"],
      "web": ["useNativeSDK", "connectionMode", "consentManagement"]
    },
    "secretKeys": ["apiKey"]
  }
}
