{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["apiKey", "conversionIdentifier", "eventMapping"],
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,500})$"
      },
      "conversionIdentifier": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,100})$"
      },
      "defaultCurrency": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^([A-Z]{3})$"
      },
      "defaultActionSource": {
        "type": "string",
        "enum": ["website", "app", "offline", "physical_store", "phone_call", "email"]
      },
      "eventMapping": {
        "type": "array",
        "minItems": 1,
        "uniqueItemProperties": ["from"],
        "items": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,100})$"
            },
            "to": {
              "type": "string",
              "enum": [
                "app_installed",
                "app_opened",
                "appointment_scheduled",
                "checkout_started",
                "contents_viewed",
                "items_added",
                "lead_created",
                "order_created",
                "page_viewed",
                "registration_completed",
                "subscription_created",
                "trial_started",
                "custom"
              ]
            },
            "conversionIdentifier": {
              "type": "string",
              "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,100})$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "to": {
                    "const": "custom"
                  }
                },
                "required": ["to"]
              },
              "then": {
                "properties": {
                  "customEventName": {
                    "type": "string",
                    "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,100})$"
                  }
                },
                "required": ["customEventName"]
              }
            }
          ]
        },
        "errorMessage": {
          "uniqueItemProperties": "Each OpenAI Ads event mapping must have a unique RudderStack Event value."
        }
      },
      "useNativeSDK": {
        "type": "object",
        "properties": {
          "web": {
            "type": "boolean"
          }
        }
      },
      "connectionMode": {
        "type": "object",
        "properties": {
          "web": {
            "type": "string",
            "enum": ["cloud", "device"]
          },
          "cloud": {
            "type": "string",
            "enum": ["cloud"]
          }
        }
      },
      "consentManagement": {
        "type": "object",
        "properties": {
          "cloud": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "iubenda", "ketch", "oneTrust"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "required": ["provider"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          },
          "web": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "iubenda", "ketch", "oneTrust"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "required": ["provider"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          }
        }
      }
    }
  }
}
