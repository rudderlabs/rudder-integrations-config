{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": [
      "apiKey",
      "conversionIdentifier",
      "defaultCurrency",
      "defaultActionSource",
      "eventsToStandard"
    ],
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "^.{1,500}$"
      },
      "conversionIdentifier": {
        "type": "string",
        "pattern": "^.{1,100}$"
      },
      "defaultCurrency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "defaultActionSource": {
        "type": "string",
        "enum": ["website", "app", "offline", "physical_store", "phone_call", "email"]
      },
      "eventsToStandard": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^.{1,100}$"
            },
            "to": {
              "type": "string",
              "enum": [
                "page_view",
                "view_content",
                "search",
                "add_to_cart",
                "add_to_wishlist",
                "initiate_checkout",
                "add_payment_info",
                "purchase",
                "lead",
                "complete_registration",
                "contact",
                "subscribe",
                "start_trial",
                "custom"
              ]
            },
            "conversionIdentifier": {
              "type": "string",
              "pattern": "^.{1,100}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "to": {
                    "const": "custom"
                  }
                },
                "required": ["to"]
              },
              "then": {
                "properties": {
                  "customEventName": {
                    "type": "string",
                    "pattern": "^.{1,100}$"
                  }
                },
                "required": ["customEventName"]
              }
            }
          ],
          "required": ["from", "to"]
        }
      },
      "consentManagement": {
        "type": "object",
        "properties": {
          "android": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "ketch", "oneTrust", "iubenda"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ],
              "required": ["provider"]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          },
