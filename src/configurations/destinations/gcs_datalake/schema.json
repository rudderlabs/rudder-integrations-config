{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["bucketName", "credentials"],
    "type": "object",
    "properties": {
      "bucketName": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^((?!goog)(?!.*google.*)(?!^(\\d+(\\.|$)){4}$)(?!.*\\.\\..*)[a-z0-9][a-z0-9-._]{1,61}[a-z0-9])$"
      },
      "prefix": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$"
      },
      "namespace": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^((?!pg_|PG_|pG_|Pg_).{0,64})$",
        "rs-immutable": true
      },
      "skipTracksTable": {
        "type": "boolean",
        "default": false
      },
      "skipUsersTable": {
        "type": "boolean",
        "default": true
      },
      "jsonPaths": {
        "type": "string",
        "pattern": "^(.*)$"
      },
      "cleanupObjectStorageFiles": {
        "type": "boolean",
        "default": false
      },
      "tableSuffix": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|.*"
      },
      "timeWindowLayout": {
        "type": "string",
        "enum": [
          "2006/01/02/15",
          "dt=2006-01-02",
          "year=2006",
          "year=2006/month=01",
          "year=2006/month=01/day=02",
          "year=2006/month=01/day=02/hour=15"
        ],
        "default": "2006/01/02/15"
      },
      "credentials": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|.*"
      },
      "syncFrequency": {
        "type": "string",
        "enum": ["5", "10", "15", "30", "60", "180", "360", "720", "1440"],
        "default": "180"
      },
      "syncStartAt": {
        "type": "string"
      },
      "allowUsersContextTraits": {
        "type": "boolean",
        "description": "Internal, immutable flag retained for backward compatibility. When false, context.traits.* fields are not promoted to top-level traits; they are stored only as context_traits_*.",
        "default": false,
        "rs-immutable": true
      },
      "underscoreDivideNumbers": {
        "type": "boolean",
        "description": "Internal, immutable flag retained for backward compatibility. When false, numeric suffixes in column names are preserved; for example v3 remains v3 instead of being split into v_3.",
        "default": false,
        "rs-immutable": true
      },
