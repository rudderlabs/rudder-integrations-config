{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "accessToken",
      "residency",
      "projectId",
      "accountId",
      "workspaceKey",
      "apiVersion",
      "deliveryMode"
    ],
    "properties": {
      "accessToken": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "residency": {
        "type": "string",
        "enum": ["us", "eu", "ap"]
      },
      "projectId": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "endpoint": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "accountId": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "workspaceKey": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "apiVersion": {
        "type": "string",
        "enum": ["2024-10", "2025-06"]
      },
      "batchSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "deliveryMode": {
        "type": "string",
        "enum": ["batch", "stream"]
      },
      "connectionMode": {
        "type": "object",
        "properties": {
          "android": {
