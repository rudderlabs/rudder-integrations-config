      "consentManagement": {
        "type": "object",
        "properties": {
          "android": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "iubenda", "ketch", "oneTrust"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          },
