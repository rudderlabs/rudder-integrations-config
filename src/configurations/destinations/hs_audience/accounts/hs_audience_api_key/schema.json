{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["accessToken"],
    "properties": {
      "accessToken": {
        "type": "string",
        "pattern": "^.*\\S.*$",
        "errorMessage": {
          "pattern": "Enter a HubSpot Service Key"
        }
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {}
  }
}
