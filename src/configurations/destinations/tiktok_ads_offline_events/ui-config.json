{
  "uiConfig": [
    {
      "title": "Connection Settings",
      "fields": [
        {
          "type": "textInput",
          "label": "Access Token",
          "value": "accessToken",
          "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
          "required": true,
          "placeholder": "e.g. 1234ac663758946dXXXX520b394bbac611b371f7",
          "secret": true,
          "footerNote": "TikTok Long Term Access Token"
        }
      ]
    },
    {
      "title": "Event Settings",
      "fields": [
        {
          "type": "dynamicSelectForm",
          "label": "Mapping to trigger the TikTok Ads Offline standard events for the respective Events",
          "labelLeft": "Event Name",
          "labelRight": "Standard Events",
          "value": "eventsToStandard",
          "keyLeft": "from",
          "keyRight": "to",
          "required": false,
          "placeholderLeft": "e.g: Sign up completed",
          "footerNote": "Events marked (Legacy) are deprecated by TikTok. Use Purchase instead of Complete Payment. Click Button and Place an Order will be retired by TikTok in 2027; use Purchase or View Content instead.",
          "footerURL": {
            "link": "https://www.rudderstack.com/docs/destinations/streaming-destinations/tiktok-ads-offline-events/#legacy-standard-events",
            "text": "Learn more about legacy TikTok events"
          },
          "options": [
            {
              "name": "Add Payment Info",
              "value": "AddPaymentInfo"
            },
            {
              "name": "Add to Cart",
              "value": "AddToCart"
            },
            {
              "name": "Add to Wishlist",
              "value": "AddToWishlist"
            },
            {
              "name": "Complete Registration",
              "value": "CompleteRegistration"
            },
            {
              "name": "Contact",
              "value": "Contact"
            },
            {
              "name": "Download",
              "value": "Download"
            },
            {
              "name": "Initiate Checkout",
              "value": "InitiateCheckout"
            },
            {
              "name": "Purchase",
              "value": "Purchase"
            },
            {
              "name": "Search",
              "value": "Search"
            },
            {
              "name": "Submit Form",
              "value": "SubmitForm"
            },
            {
              "name": "Subscribe",
              "value": "Subscribe"
            },
            {
              "name": "View Content",
              "value": "ViewContent"
            },
            {
              "name": "Click Button (Legacy)",
              "value": "ClickButton"
            },
            {
              "name": "Complete Payment (Legacy)",
              "value": "CompletePayment"
            },
            {
              "name": "Place an Order (Legacy)",
              "value": "PlaceAnOrder"
            }
          ]
        }
      ]
    },
    {
      "title": "Other Settings",
      "fields": [
        {
          "type": "checkbox",
          "label": "Hash Contextual User Properties (SHA-256)",
          "value": "hashUserProperties",
          "default": true,
          "footerNote": "To hash user properties like email and phone number using SHA-256. Only applicable for cloud mode."
        }
      ]
    },
    {
      "title": "Consent Settings",
      "fields": [
        {
          "type": "dynamicCustomForm",
          "value": "consentManagement",
          "label": "Consent management settings",
          "footerNote": "We recommend using IDs instead of names as IDs are unique and less likely to change over time, making them a more reliable choice.",
          "customFields": [
            {
              "type": "singleSelect",
              "label": "Consent management provider",
              "value": "provider",
              "options": [
                {
                  "name": "Custom",
                  "value": "custom"
                },
                {
                  "name": "iubenda",
                  "value": "iubenda"
                },
                {
                  "name": "Ketch",
                  "value": "ketch"
                },
                {
                  "name": "OneTrust",
                  "value": "oneTrust"
                }
              ],
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "the required consent logic",
              "value": "resolutionStrategy",
              "options": [
                {
                  "name": "AND",
                  "value": "and"
                },
                {
                  "name": "OR",
                  "value": "or"
                }
              ],
              "required": true,
              "variant": "badge",
              "preRequisites": {
                "fields": [
                  {
                    "configKey": "provider",
                    "value": "custom"
                  }
                ]
              }
            },
            {
              "type": "dynamicCustomForm",
              "value": "consents",
              "label": "Enter consent category IDs",
              "customFields": [
                {
                  "type": "textInput",
                  "placeholder": "Marketing",
                  "value": "consent",
                  "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                  "required": false
                }
              ]
            }
          ],
          "uniqueRowFields": ["provider"]
        }
      ]
    }
  ]
}
