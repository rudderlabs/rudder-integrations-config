{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["clientId", "clientSecret"],
    "properties": {
      "clientId": {
        "type": "string",
        "pattern": "^(?=.{1,100}$).*\\S.*$",
        "errorMessage": {
          "pattern": "Enter a client ID of 1 to 100 characters that is not only spaces"
        }
      },
      "clientSecret": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": {
          "pattern": "Enter a client secret of 1 to 500 characters that is not only spaces"
        }
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["accountId"],
    "properties": {
      "accountId": {
        "type": "string",
        "pattern": "^[0-9A-Za-z]{3}-[0-9A-Za-z]{3}-[0-9A-Za-z]{3}$",
        "errorMessage": {
          "pattern": "Enter a Munchkin ID such as 123-ABC-456"
        }
      }
    }
  }
}
