{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["serverToServerSecret"],
    "properties": {
      "serverToServerSecret": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Secret"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["serverToServerKey"],
    "properties": {
      "serverToServerKey": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Key"
      }
    }
  }
}
