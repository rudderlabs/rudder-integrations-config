{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["serverToServerSecret"],
    "properties": {
      "serverToServerSecret": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Secret"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiEndpoint", "serverToServerKey"],
    "properties": {
      "apiEndpoint": {
        "type": "string",
        "pattern": "^https://(?:[a-zA-Z0-9-]{1,63}\\.)*mparticle\\.com(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~-]+)*/?$",
        "errorMessage": "Enter a valid HTTPS API endpoint on mparticle.com, with an optional path (e.g. https://inbound.mparticle.com/s2s)"
      },
      "serverToServerKey": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Key"
      }
    }
  }
}
