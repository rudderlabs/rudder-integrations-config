{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["serverToServerSecret"],
    "properties": {
      "serverToServerSecret": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Secret"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiEndpoint", "serverToServerKey"],
    "properties": {
      "apiEndpoint": {
        "type": "string",
        "pattern": "^(https://)(?![a-zA-Z0-9-]*\\.ngrok\\.io)(?!localhost|.*\\.localhost)([a-zA-Z0-9-]{1,63}\\.)+[a-zA-Z]{2,}(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]\\d{4}|[1-9]\\d{1,3}))?(/[^?#\\s]*)?$",
        "errorMessage": "Enter a valid HTTPS API endpoint without query parameters or fragments"
      },
      "serverToServerKey": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Key"
      }
    }
  }
}
