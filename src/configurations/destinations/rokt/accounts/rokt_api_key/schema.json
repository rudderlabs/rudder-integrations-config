{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["serverToServerSecret"],
    "properties": {
      "serverToServerSecret": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Secret"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiEndpoint", "serverToServerKey"],
    "properties": {
      "apiEndpoint": {
        "type": "string",
        "pattern": "^https://s2s(?:\\.(?:us2|eu1|au1))?\\.mparticle\\.com/?$",
        "errorMessage": "Enter a supported mParticle Events API endpoint"
      },
      "serverToServerKey": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a Server to Server Key"
      }
    }
  }
}
