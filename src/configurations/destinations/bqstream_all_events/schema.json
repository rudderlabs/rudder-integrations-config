{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["project", "namespace", "credentials"],
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "location": {
        "type": "string",
        "pattern": "^(.{0,100})$"
      },
      "namespace": {
        "type": "string",
        "pattern": "^((?!pg_|PG_|pG_|Pg_).{1,64})$",
        "rs-immutable": true
      },
      "credentials": {
        "type": "string",
        "pattern": ".+"
      },
      "partitionColumn": {
        "type": "string",
        "enum": [
          "_PARTITIONTIME",
          "loaded_at",
          "received_at",
          "timestamp",
          "sent_at",
          "original_timestamp"
        ],
        "default": "_PARTITIONTIME",
        "rs-immutable": true
      },
      "partitionType": {
        "type": "string",
        "enum": ["hour", "day"],
        "default": "day",
        "rs-immutable": true
      },
      "skipTracksTable": {
        "type": "boolean",
        "default": false
      },
      "skipViews": {
        "type": "boolean",
        "default": false,
        "rs-immutable": true
      },
      "jsonPaths": {
        "type": "string",
        "pattern": "^(.*)$"
      },
      "allowUsersContextTraits": {
        "type": "boolean",
        "default": false
      },
      "underscoreDivideNumbers": {
        "type": "boolean",
        "default": false
      },
      "consentManagement": {
        "type": "object",
        "properties": {
          "cloud": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "iubenda", "ketch", "oneTrust"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          },
          "cloudSource": {
            "type": "array",
