{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "verificationToken": {
        "type": "string",
        "pattern": "^.{0,200}$"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["postbackUrl", "networkId"],
    "properties": {
      "postbackUrl": {
        "type": "string",
        "pattern": "^(https?://)(?![a-zA-Z0-9-]*\\.ngrok\\.io)(?!localhost|.*\\.localhost)([a-zA-Z0-9-]{1,63}\\.)+[a-zA-Z]{2,}(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]\\d{4}|[1-9]\\d{1,3}))?(/[^?#\\s]*)?$",
        "errorMessage": "Paste only the base Global Postback URL and remove everything from ? onward"
      },
      "networkId": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a Network ID"
      }
    }
  }
}
