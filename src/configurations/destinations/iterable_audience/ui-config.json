{
  "uiConfig": {
    "baseTemplate": [
      {
        "title": "Initial setup",
        "note": "Configure your Iterable Audience connection",
        "sections": [
          {
            "groups": [
              {
                "title": "Connection settings",
                "note": "Set API credentials and project configuration",
                "icon": "settings",
                "fields": [
                  {
                    "type": "textInput",
                    "label": "Iterable API Key",
                    "configKey": "apiKey",
                    "regex": "^(.{1,200})$",
                    "regexErrorMessage": "Invalid Iterable API key",
                    "placeholder": "e.g: 42f1873107050XXXX4bd0bd694905664ae",
                    "secret": true
                  },
                  {
                    "type": "singleSelect",
                    "label": "Project Type",
                    "configKey": "projectType",
                    "options": [
                      {
                        "label": "Email-based",
                        "value": "email_based"
                      },
                      {
                        "label": "Hybrid",
                        "value": "hybrid"
                      },
                      {
                        "label": "UserID-based",
                        "value": "userid_based"
                      }
                    ]
                  },
                  {
                    "type": "singleSelect",
                    "label": "Data Center",
                    "configKey": "dataCenter",
                    "options": [
                      {
                        "label": "USDC",
                        "value": "USDC"
                      },
                      {
                        "label": "EUDC",
                        "value": "EUDC"
                      }
                    ],
                    "default": "USDC"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
