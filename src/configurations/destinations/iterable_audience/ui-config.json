{
  "uiConfig": {
    "baseTemplate": [
      {
        "title": "Initial setup",
        "note": "Review how this destination is set up",
        "sections": [
          {
            "groups": [
              {
                "title": "Connection settings",
                "note": "Update your connection settings here",
                "icon": "settings",
                "fields": [
                  {
                    "type": "accountManagementInput",
                    "label": "Iterable account",
                    "configKey": "rudderAccountId"
                  },
                  {
                    "type": "textInput",
                    "label": "Email column",
                    "note": "Warehouse column containing email addresses (mapped to Iterable's email identifier)",
                    "configKey": "identifierMappings.0.warehouseColumn",
                    "placeholder": "e.g: email_address",
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "rudderAccountId",
                          "exists": true
                        },
                        {
                          "configKey": "accountOptions.projectType",
                          "value": "email-based"
                        }
                      ],
                      "condition": "and"
                    }
                  },
                  {
                    "type": "textInput",
                    "label": "User ID column",
                    "note": "Warehouse column containing user IDs (mapped to Iterable's userId identifier)",
                    "configKey": "identifierMappings.0.warehouseColumn",
                    "placeholder": "e.g: user_id",
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "rudderAccountId",
                          "exists": true
                        },
                        {
                          "configKey": "accountOptions.projectType",
                          "value": "userId-based"
                        }
                      ],
                      "condition": "and"
                    }
                  },
                  {
                    "type": "textInput",
                    "label": "Email column",
                    "note": "Warehouse column containing email addresses",
                    "configKey": "identifierMappings.0.warehouseColumn",
                    "placeholder": "e.g: email_address",
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "rudderAccountId",
                          "exists": true
                        },
                        {
                          "configKey": "accountOptions.projectType",
                          "value": "hybrid"
                        }
                      ],
                      "condition": "and"
                    }
                  },
                  {
                    "type": "textInput",
                    "label": "User ID column",
                    "note": "Per Iterable's API, each row is sent with either `email` or `userId` — never both. When both columns have a value on a row, RudderStack sends `userId` since it is Iterable's primary matching key for hybrid projects.",
                    "configKey": "identifierMappings.1.warehouseColumn",
                    "placeholder": "e.g: user_id",
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "rudderAccountId",
                          "exists": true
                        },
                        {
                          "configKey": "accountOptions.projectType",
                          "value": "hybrid"
                        }
                      ],
                      "condition": "and"
                    }
                  }
                ]
              }
            ]
          },
          {
            "groups": [
              {
                "title": "Connection mode",
                "note": [
                  "Update how you want to route events from your source to destination. ",
                  {
                    "text": "Get help deciding",
                    "link": "https://www.rudderstack.com/docs/destinations/rudderstack-connection-modes/"
                  }
                ],
                "icon": "sliders",
                "fields": []
              }
            ]
          }
        ]
      }
    ],
    "sdkTemplate": {
      "title": "SDK settings",
      "note": "not visible in the ui",
      "fields": []
    }
  }
}
