{
  "uiConfig": {
    "name": "API Key",
    "icon": "key",
    "description": "Authenticate using an Iterable server-side API key",
    "recommended": true,
    "form": {
      "title": "Connect your Iterable account",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Iterable Audience prod",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "API Key",
          "placeholder": "e.g: a1b2c3d4e5f6...",
          "key": ["options", "apiKey"],
          "secret": true,
          "note": "Enter a server-side standard API key from your Iterable project. Client-side keys are not supported."
        },
        {
          "component": "selectField",
          "label": "Data Center",
          "key": ["options", "dataCenter"],
          "options": [
            {
              "label": "US",
              "value": "US"
            },
            {
              "label": "EU",
              "value": "EU"
            }
          ],
          "default": "US"
        },
        {
          "component": "selectField",
          "label": "Project Type",
          "key": ["options", "projectType"],
          "options": [
            {
              "label": "Email-based",
              "value": "email-based"
            },
            {
              "label": "Hybrid",
              "value": "hybrid"
            },
            {
              "label": "UserId-based",
              "value": "userId-based"
            }
          ],
          "default": "hybrid",
          "note": "Find this in Iterable under Settings > Project Settings > Unique Identifier. Cannot be changed after a project is created."
        }
      ]
    }
  }
}
