{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|^(.{1,200})$"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["dataCenter", "projectType"],
    "properties": {
      "dataCenter": {
        "type": "string",
        "enum": ["US", "EU"],
        "default": "US"
      },
      "projectType": {
        "type": "string",
        "enum": ["email-based", "hybrid", "userId-based"],
        "default": "hybrid"
      }
    }
  }
}
