{
  "name": "ITERABLE_AUDIENCE",
  "displayName": "Iterable Audience",
  "config": {
    "supportsBlankAudienceCreation": true,
    "disableJsonMapper": true,
    "supportsVisualMapper": true,
    "syncBehaviours": ["upsert", "mirror"],
    "transformAtV1": "router",
    "saveDestinationResponse": true,
    "excludeKeys": [],
    "supportedSourceTypes": ["warehouse"],
    "supportedMessageTypes": {
      "cloud": ["record"]
    },
    "isAudienceSupported": true,
    "supportedConnectionModes": {
      "warehouse": ["cloud"]
    },
    "destConfig": {
      "defaultConfig": ["apiKey", "dataCenter", "projectType"],
      "warehouse": [
        "connectionMode",
        "consentManagement",
        "oneTrustCookieCategories",
        "ketchConsentPurposes"
      ]
    },
    "secretKeys": ["apiKey"]
  },
  "options": {
    "isBeta": true
  }
}
