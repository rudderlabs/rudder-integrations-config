{
  "name": "TIKTOK_AUDIENCE",
  "displayName": "Tiktok Audience",
  "version": "1.0",
  "config": {
    "cdkV2Enabled": true,
    "disableJsonMapper": true,
    "excludeKeys": [],
    "auth": {
      "type": "OAuth",
      "role": "tiktok_audience"
    },
    "saveDestinationResponse": true,
    "supportedMessageTypes": {
      "cloud": ["audiencelist", "record"]
    },
    "supportedAccountDefinitions": {
      "rudderAccountId": ["DESTINATION_TIKTOK_AUDIENCE_OAUTH"]
    },
    "supportedSourceTypes": ["warehouse"],
    "supportsVisualMapperV2": true,
    "syncBehaviours": ["mirror"],
    "transformAtV1": "router",
    "destConfig": {
      "defaultConfig": ["advertiserId", "rudderAccountId"],
      "warehouse": ["adAccountId", "connectionMode"]
    },
    "supportedConnectionModes": {
      "warehouse": ["cloud"]
    }
  }
}
