{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["rudderAccountId"],
    "properties": {
      "rudderAccountId": {
        "type": "string"
      },
      "connectionMode": {
        "type": "object",
        "properties": {
          "warehouse": {
            "type": "string",
            "enum": ["cloud"]
          }
        }
      }
    },
    "allOf": [
      {
        "properties": {
          "rudderAccountId": {
            "type": "string",
            "pattern": "^[0-9A-Za-z]{27}$"
          }
        }
      }
    ]
  }
}
