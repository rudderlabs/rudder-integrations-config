{
  "uiConfig": {
    "baseTemplate": [
      {
        "title": "Initial setup",
        "note": "Review how this destination is set up",
        "sections": [
          {
            "groups": [
              {
                "title": "Connection Settings",
                "note": "Update your connection settings here",
                "icon": "settings",
                "fields": [
                  {
                    "type": "accountManagementInput",
                    "label": "Event delivery account",
                    "configKey": "rudderAccountId"
                  },
                  {
                    "type": "textInput",
                    "label": "Customer ID",
                    "note": "Enter the Customer ID",
                    "configKey": "customerId",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,100})$",
                    "regexErrorMessage": "Invalid Customer Id",
                    "required": true,
                    "placeholder": "e.g: 6293X29833"
                  },
                  {
                    "type": "checkbox",
                    "label": "Sub Account",
                    "configKey": "subAccount",
                    "default": false
                  },
                  {
                    "type": "textInput",
                    "label": "Login Customer ID",
                    "note": "If Customer ID is from a sub-account, provide the manager account's Customer ID.",
                    "configKey": "loginCustomerId",
                    "regex": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$",
                    "regexErrorMessage": "Invalid Login Customer Id",
                    "required": false,
                    "preRequisites": {
                      "fields": [
                        {
                          "configKey": "subAccount",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "groups": [
              {
                "title": "Connection mode",
                "note": [
                  "Update how you want to route events from your source to destination. ",
                  {
                    "text": "Get help deciding",
                    "link": "https://www.rudderstack.com/docs/destinations/rudderstack-connection-modes/"
                  }
                ],
                "icon": "sliders",
                "fields": []
              }
            ]
          }
        ]
      },
      {
        "title": "Event mapping",
        "note": "Map RudderStack events and variables to Google Ads Offline Conversions",
        "hideEditIcon": true,
        "sections": [
          {
            "groups": [
              {
                "title": "RudderStack to Google Ads Offline Conversions mappings",
                "fields": [
                  {
                    "type": "redirect",
                    "redirectGroupKey": "eventMapping",
                    "label": "Event mapping",
                    "note": "Map RudderStack events and variables to Google Ads Offline Conversions."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Configuration settings",
        "note": "Manage the settings for your destination",
        "sections": [
          {
            "title": "Event settings",
            "note": "Configure your event-level settings",
            "icon": "settings",
            "groups": [
              {
                "title": "Conversion settings",
                "note": "Configure how RudderStack events are sent as Google Ads offline conversions",
                "fields": [
                  {
                    "type": "singleSelect",
                    "label": "User Identifier Source",
                    "configKey": "UserIdentifierSource",
                    "note": "Source of the user identifier",
                    "options": [
                      {
                        "label": "None",
                        "value": "none"
                      },
                      {
                        "label": "UNSPECIFIED",
                        "value": "UNSPECIFIED"
                      },
                      {
                        "label": "UNKNOWN",
                        "value": "UNKNOWN"
                      },
                      {
                        "label": "FIRST_PARTY",
                        "value": "FIRST_PARTY"
                      },
                      {
                        "label": "THIRD_PARTY",
                        "value": "THIRD_PARTY"
                      }
                    ],
                    "default": "none"
                  },
                  {
                    "type": "singleSelect",
                    "label": "Conversion Environment",
                    "configKey": "conversionEnvironment",
                    "note": "The environment this conversion was recorded on, such as App or Web.",
                    "options": [
                      {
                        "label": "None",
                        "value": "none"
                      },
                      {
                        "label": "UNSPECIFIED",
                        "value": "UNSPECIFIED"
                      },
                      {
                        "label": "UNKNOWN",
                        "value": "UNKNOWN"
                      },
                      {
                        "label": "APP",
                        "value": "APP"
                      },
                      {
                        "label": "WEB",
                        "value": "WEB"
                      }
                    ],
                    "default": "none"
                  },
                  {
                    "type": "singleSelect",
                    "label": "Default user identifier for store and click conversions",
                    "configKey": "defaultUserIdentifier",
                    "options": [
                      {
                        "label": "Email",
                        "value": "email"
                      },
                      {
                        "label": "Phone number",
                        "value": "phone"
                      }
                    ],
                    "default": "email"
                  },
                  {
                    "type": "checkbox",
                    "label": "Hash User Identifying Information (SHA-256)",
                    "configKey": "hashUserIdentifier",
                    "default": true,
                    "note": "Hash user-identifying information like email, phone number, first name, last name, and address using SHA-256."
                  },
                  {
                    "type": "checkbox",
                    "label": "Validate Only",
                    "configKey": "validateOnly",
                    "default": false,
                    "note": "Enable this option to only validate the request."
                  }
                ]
              }
            ]
          },
          {
            "id": "consentSettings",
            "title": "Consent settings",
            "note": "Configure consent settings for each provider here",
            "icon": "settings",
            "groups": []
          }
        ]
      }
    ],
    "sdkTemplate": {
      "title": "Web SDK settings",
      "note": "not visible in the ui",
      "fields": []
    },
    "redirectGroups": {
      "eventMapping": {
        "tabs": [
          {
            "name": "Conversion mappings",
            "fields": [
              {
                "type": "mapping",
                "label": "Map your Google Ads Conversions Names",
                "configKey": "eventsToConversionsNamesMapping",
                "default": [],
                "columns": [
                  {
                    "type": "textInput",
                    "configKey": "from",
                    "label": "RudderStack event names",
                    "placeholder": "e.g: Sign up completed",
                    "regex": "^(.{0,100})$"
                  },
                  {
                    "type": "textInput",
                    "configKey": "to",
                    "label": "Google Ads conversion names",
                    "placeholder": "e.g: App Sign-up",
                    "regex": "^(.{0,100})$"
                  }
                ]
              },
              {
                "type": "mapping",
                "label": "Map your events with Google Ads Offline Conversions",
                "configKey": "eventsToOfflineConversionsTypeMapping",
                "default": [],
                "columns": [
                  {
                    "type": "textInput",
                    "configKey": "from",
                    "label": "RudderStack event names",
                    "placeholder": "e.g: Sign up completed",
                    "regex": "^(.{0,100})$"
                  },
                  {
                    "type": "singleSelect",
                    "configKey": "to",
                    "label": "Google Ads offline conversions",
                    "options": [
                      {
                        "label": "Click",
                        "value": "click"
                      },
                      {
                        "label": "Call",
                        "value": "call"
                      },
                      {
                        "label": "Store",
                        "value": "store"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "name": "Custom variable mapping",
            "fields": [
              {
                "type": "mapping",
                "label": "Map your variable names to custom Google Ads variables",
                "configKey": "customVariables",
                "default": [],
                "columns": [
                  {
                    "type": "textInput",
                    "configKey": "from",
                    "label": "Custom variable names",
                    "placeholder": "e.g: value",
                    "regex": "^(.{0,100})$"
                  },
                  {
                    "type": "textInput",
                    "configKey": "to",
                    "label": "Google Ads custom variables",
                    "placeholder": "e.g: revenue",
                    "regex": "^(.{0,100})$"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "consentSettingsTemplate": {
      "title": "Consent settings",
      "note": "not visible in the ui",
      "fields": [
        {
          "type": "dynamicCustomForm",
          "configKey": "consentManagement",
          "default": [],
          "rowFields": [
            {
              "type": "singleSelect",
              "label": "Consent management provider",
              "configKey": "provider",
              "options": [
                {
                  "label": "Custom",
                  "value": "custom"
                },
                {
                  "label": "iubenda",
                  "value": "iubenda"
                },
                {
                  "label": "Ketch",
                  "value": "ketch"
                },
                {
                  "label": "OneTrust",
                  "value": "oneTrust"
                }
              ],
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "the required consent logic",
              "configKey": "resolutionStrategy",
              "options": [
                {
                  "label": "AND",
                  "value": "and"
                },
                {
                  "label": "OR",
                  "value": "or"
                }
              ],
              "required": true,
              "variant": "badge",
              "preRequisites": {
                "fields": [
                  {
                    "configKey": "provider",
                    "value": "custom"
                  }
                ]
              }
            },
            {
              "type": "tagInput",
              "label": "Enter consent category IDs",
              "note": "Input your consent category IDs by pressing 'Enter' after each entry. We recommend using IDs instead of names as IDs are unique and less likely to change over time, making them a more reliable choice.",
              "configKey": "consents",
              "tagKey": "consent",
              "placeholder": "e.g: Marketing",
              "default": [
                {
                  "consent": ""
                }
              ]
            }
          ],
          "uniqueRowFields": ["provider"]
        }
      ]
    }
  }
}
