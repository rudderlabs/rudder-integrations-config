{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "required": ["project", "namespace", "credentials"],
    "properties": {
      "project": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{1,100})$"
      },
      "location": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.{0,100})$"
      },
      "namespace": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^((?!pg_|PG_|pG_|Pg_).{1,64})$",
        "rs-immutable": true
      },
      "credentials": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|.+"
      },
      "partitionColumn": {
        "type": "string",
        "pattern": "^(_PARTITIONTIME|loaded_at|received_at|timestamp|sent_at|original_timestamp)$",
        "default": "_PARTITIONTIME",
        "rs-immutable": true
      },
      "partitionType": {
        "type": "string",
        "pattern": "^(hour|day)$",
        "default": "day",
        "rs-immutable": true
      },
      "skipTracksTable": {
        "type": "boolean",
        "default": false
      },
      "skipViews": {
        "type": "boolean",
        "default": false,
        "rs-immutable": true
      },
      "jsonPaths": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^(.*)$"
      },
      "connectionMode": {
        "type": "object",
        "properties": {
          "android": {
            "type": "string",
            "enum": ["cloud"]
          },
          "androidKotlin": {
            "type": "string",
            "enum": ["cloud"]
          },
          "ios": {
            "type": "string",
            "enum": ["cloud"]
          },
          "iosSwift": {
            "type": "string",
            "enum": ["cloud"]
          },
          "web": {
            "type": "string",
            "enum": ["cloud"]
          },
          "unity": {
            "type": "string",
            "enum": ["cloud"]
          },
          "amp": {
            "type": "string",
            "enum": ["cloud"]
          },
          "cloud": {
            "type": "string",
            "enum": ["cloud"]
          },
          "reactnative": {
            "type": "string",
            "enum": ["cloud"]
          },
          "cloudSource": {
            "type": "string",
            "enum": ["cloud"]
          },
          "flutter": {
            "type": "string",
            "enum": ["cloud"]
          },
          "cordova": {
            "type": "string",
            "enum": ["cloud"]
          },
          "shopify": {
            "type": "string",
            "enum": ["cloud"]
          }
        }
      }
    }
  }
}
