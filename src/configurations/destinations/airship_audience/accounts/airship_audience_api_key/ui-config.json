{
  "uiConfig": {
    "name": "API Key",
    "icon": "key",
    "description": "Authenticate using an Airship access token",
    "recommended": true,
    "form": {
      "title": "Connect your Airship project",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Airship prod",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "Access token",
          "placeholder": "e.g: AbCdEf123...",
          "key": ["options", "apiKey"],
          "secret": true,
          "note": "Settings › Tokens, role Audience Modification"
        },
        {
          "component": "selectField",
          "label": "Region",
          "key": ["options", "dataCenter"],
          "options": [
            { "label": "US", "value": "US" },
            { "label": "EU", "value": "EU" }
          ],
          "default": "US",
          "note": "EU if your dashboard is go.airship.eu"
        },
        {
          "component": "textField",
          "label": "Tag group key",
          "placeholder": "rudderstack_audiences",
          "key": ["options", "tagGroup"],
          "note": "Create it first under Audience › Tags › Tag Groups. Use the group key, not its name."
        }
      ]
    }
  }
}
