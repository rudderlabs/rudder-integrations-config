{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "^[!-~]{1,200}$",
        "errorMessage": "Enter an Airship access token of up to 200 characters, with no spaces"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["dataCenter", "tagGroup"],
    "properties": {
      "dataCenter": {
        "type": "string",
        "enum": ["US", "EU"],
        "default": "US"
      },
      "tagGroup": {
        "type": "string",
        "pattern": "^[!-~](?:[ -~]{0,126}[!-~])?$",
        "errorMessage": "Enter the Airship tag group key, 1 to 128 characters, with no leading or trailing space",
        "default": "rudderstack_audiences"
      }
    }
  }
}
