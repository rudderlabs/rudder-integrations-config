{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKeyValue"],
    "properties": {
      "apiKeyValue": {
        "type": "string",
        "pattern": "^(.{1,100})$",
        "errorMessage": "Enter a value between 1 and 100 characters"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKeyName"],
    "properties": {
      "apiKeyName": {
        "type": "string",
        "pattern": "^(\\S{1,100})$",
        "errorMessage": "Enter a key name without spaces, 100 characters or less"
      }
    }
  }
}
