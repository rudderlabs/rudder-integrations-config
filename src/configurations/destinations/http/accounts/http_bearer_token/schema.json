{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["bearerToken"],
    "properties": {
      "bearerToken": {
        "type": "string",
        "pattern": "^(.{1,2048})$",
        "errorMessage": "Enter a token between 1 and 2048 characters"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {}
  }
}
