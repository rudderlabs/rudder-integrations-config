            { "required": ["pathParams"] },
            { "required": ["queryParams"] },
            { "required": ["requestBodyTemplate"] },
            { "required": ["maxBatchSize"] }
          ],
          "errorMessage": {
            "anyOf": "must override at least one of pathParams, queryParams, requestBodyTemplate, maxBatchSize"
          },
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(?=.{1,100}$).*\\S.*$"
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^.*\\S.*$"
              }
            },
            "pathParams": { "$ref": "#/definitions/pathParams" },
            "queryParams": { "$ref": "#/definitions/queryParams" },
            "requestBodyTemplate": { "$ref": "#/definitions/requestBodyTemplate" },
            "maxBatchSize": { "$ref": "#/definitions/maxBatchSize" }
          }
        }
      }
    },
    "definitions": {
      "pathParams": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        }
      },
      "queryParams": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "pattern": "^(?!\\$)[A-Za-z0-9!#$%&'*+.^_`|~\\- ]{1,100}$"
            },
            "from": {
              "type": "string"
            }
          },
          "required": ["to"]
        }
      },
      "requestBodyTemplate": {
        "type": "string",
        "pattern": "^[\\s\\S]{1,}$"
      },
      "maxBatchSize": {
        "type": "string",
        "pattern": "^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "format": {
              "enum": ["JSON", "XML"]
            }
          },
          "required": ["format"]
        },
        "then": {
          "required": ["maxBatchSize"]
        }
      },
      {
        "if": {
          "properties": {
            "authenticationEnabled": {
              "const": true
            }
          },
          "required": ["authenticationEnabled"]
        },
        "then": {
          "required": ["rudderAccountId"],
          "properties": {
            "rudderAccountId": {
              "type": "string",
              "pattern": "^.{1,100}$"
            }
          }
        }
      },
      {
        "not": {
          "anyOf": [
            {
              "required": ["auth"]
            },
            {
              "required": ["username"]
            },
            {
              "required": ["password"]
            },
            {
              "required": ["bearerToken"]
            },
            {
              "required": ["apiKeyName"]
            },
            {
              "required": ["apiKeyValue"]
            }
          ]
        }
      }
    ]
  }
}
