                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
