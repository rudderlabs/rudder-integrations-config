{
  "name": "MAXCOMPUTE",
  "displayName": "MaxCompute",
  "version": "1.0",
  "category": "warehouse",
  "config": {
    "supportedAccountDefinitions": {
      "rudderAccountId": ["DESTINATION_MAXCOMPUTE_ROLE", "DESTINATION_MAXCOMPUTE_ACCESS_KEY"]
    },
    "transformAtV1": "processor",
    "saveDestinationResponse": true,
    "supportedSourceTypes": [
      "android",
      "androidKotlin",
      "ios",
      "iosSwift",
      "web",
      "unity",
      "amp",
      "cloud",
      "reactnative",
      "cloudSource",
      "flutter",
      "cordova",
      "shopify"
    ],
    "supportedConnectionModes": {
      "android": ["cloud"],
      "androidKotlin": ["cloud"],
      "ios": ["cloud"],
      "iosSwift": ["cloud"],
      "web": ["cloud"],
      "unity": ["cloud"],
      "amp": ["cloud"],
      "cloud": ["cloud"],
      "reactnative": ["cloud"],
      "cloudSource": ["cloud"],
      "flutter": ["cloud"],
      "cordova": ["cloud"],
      "shopify": ["cloud"]
    },
    "immutableKeys": ["namespace", "skipViews", "partitionColumn", "partitionType"],
    "destConfig": {
      "defaultConfig": [
        "rudderAccountId",
        "iamRoleARN",
        "ossRoleArn",
        "accessKeyId",
        "accessKeySecret",
        "project",
        "endpoint",
        "region",
        "bucketName",
        "namespace",
        "syncFrequency",
        "syncStartAt",
        "excludeWindow",
        "skipViews",
        "partitionColumn",
        "partitionType",
        "skipUsersTable",
        "skipTracksTable",
        "cleanupObjectStorageFiles"
      ],
      "android": ["connectionMode", "consentManagement"],
      "androidKotlin": ["connectionMode", "consentManagement"],
      "ios": ["connectionMode", "consentManagement"],
      "iosSwift": ["connectionMode", "consentManagement"],
      "web": ["connectionMode", "consentManagement"],
      "unity": ["connectionMode", "consentManagement"],
      "amp": ["connectionMode", "consentManagement"],
      "cloud": ["connectionMode", "consentManagement"],
      "reactnative": ["connectionMode", "consentManagement"],
      "cloudSource": ["connectionMode", "consentManagement"],
      "flutter": ["connectionMode", "consentManagement"],
      "cordova": ["connectionMode", "consentManagement"],
      "shopify": ["connectionMode", "consentManagement"]
    },
    "secretKeys": ["accessKeySecret"]
  },
  "options": {
    "isBeta": true,
    "icon": "maxcompute",
    "hidden": {
      "gate": {
        "flags": [
          {
            "name": "AMP_enable-maxcompute-destination",
            "value": false
          }
        ]
      }
    }
  }
}
