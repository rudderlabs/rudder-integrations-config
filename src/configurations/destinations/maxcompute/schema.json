{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": [
      "rudderAccountId",
      "project",
      "region",
      "endpoint",
      "bucketName",
      "namespace",
      "skipViews",
      "partitionColumn",
      "partitionType"
    ],
    "type": "object",
    "properties": {
      "rudderAccountId": {
        "type": "string",
        "pattern": "^.{1,100}$"
      },
      "project": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{2,27}$"
      },
      "region": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[a-z0-9]+)+$"
      },
      "endpoint": {
        "type": "string",
        "pattern": "^https://service\\.[a-z]{2}(?:-[a-z0-9]+)+\\.maxcompute\\.aliyun\\.com/api/?$"
      },
      "bucketName": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
      },
      "prefix": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F'\\\\]{0,100}$"
      },
      "namespace": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,126}$",
        "rs-immutable": true
      },
      "skipViews": {
        "type": "boolean",
        "default": false,
        "rs-immutable": true
      },
      "partitionColumn": {
        "type": "string",
        "enum": [
          "_PARTITIONTIME",
          "loaded_at",
          "received_at",
          "timestamp",
          "sent_at",
          "original_timestamp"
        ],
        "default": "_PARTITIONTIME",
        "rs-immutable": true
      },
      "partitionType": {
        "type": "string",
        "enum": ["hour", "day"],
        "default": "day",
        "rs-immutable": true
      },
      "syncFrequency": {
        "type": "string",
        "enum": ["5", "10", "15", "30", "60", "180", "360", "720", "1440"],
        "default": "180"
      },
      "syncStartAt": {
        "type": "string"
      },
      "excludeWindow": {
        "type": "object",
        "properties": {
          "excludeWindowStartTime": {
            "type": "string"
          },
          "excludeWindowEndTime": {
            "type": "string"
          }
        },
        "required": ["excludeWindowStartTime", "excludeWindowEndTime"]
      },
      "skipUsersTable": {
        "type": "boolean",
        "default": true
      },
      "skipTracksTable": {
        "type": "boolean",
        "default": false
      },
      "cleanupObjectStorageFiles": {
        "type": "boolean",
        "default": true
      },
      "consentManagement": {
        "type": "object",
        "properties": {
          "android": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "iubenda", "ketch", "oneTrust"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ],
              "required": ["provider"]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          },
