{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["accessKeySecret"],
    "properties": {
      "accessKeySecret": {
        "type": "string",
        "pattern": "^.{1,500}$",
        "errorMessage": "Enter an access key secret of up to 500 characters"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["accessKeyId", "ossRoleArn"],
    "properties": {
      "accessKeyId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{1,128}$",
        "errorMessage": "Enter an access key ID of up to 128 characters"
      },
      "ossRoleArn": {
        "type": "string",
        "pattern": "^acs:ram::[0-9]+:role/[A-Za-z0-9.-]{1,64}$",
        "errorMessage": "Enter a valid OSS RAM role ARN"
      }
    }
  }
}
