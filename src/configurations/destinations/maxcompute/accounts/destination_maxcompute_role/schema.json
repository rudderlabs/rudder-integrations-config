{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [],
    "properties": {}
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["iamRoleARN", "ossRoleArn"],
    "properties": {
      "iamRoleARN": {
        "type": "string",
        "pattern": "^acs:ram::[0-9]+:role/[A-Za-z0-9.-]{1,64}$",
        "errorMessage": "Enter a valid MaxCompute RAM role ARN"
      },
      "ossRoleArn": {
        "type": "string",
        "pattern": "^acs:ram::[0-9]+:role/[A-Za-z0-9.-]{1,64}$",
        "errorMessage": "Enter a valid OSS RAM role ARN"
      }
    }
  }
}
