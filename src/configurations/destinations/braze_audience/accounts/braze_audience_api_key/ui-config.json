{
  "uiConfig": {
    "name": "API Key",
    "icon": "key",
    "description": "Authenticate using a Braze server-side REST API key",
    "recommended": true,
    "form": {
      "title": "Connect your Braze account",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Braze Audiences prod",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "REST API Key",
          "placeholder": "e.g: a1b2c3d4-e5f6-...",
          "key": ["options", "restApiKey"],
          "secret": true,
          "note": "Server-side REST API key from Braze (Settings → APIs and Identifiers). Requires users.track.bulk. /users/track/bulk may need Braze early access on the workspace."
        },
        {
          "component": "selectField",
          "label": "Data Center",
          "key": ["options", "dataCenter"],
          "options": [
            { "label": "US-01", "value": "US-01" },
            { "label": "US-02", "value": "US-02" },
            { "label": "US-03", "value": "US-03" },
            { "label": "US-04", "value": "US-04" },
            { "label": "US-05", "value": "US-05" },
            { "label": "US-06", "value": "US-06" },
            { "label": "US-07", "value": "US-07" },
            { "label": "US-08", "value": "US-08" },
            { "label": "EU-01", "value": "EU-01" },
            { "label": "EU-02", "value": "EU-02" },
            { "label": "EU-03", "value": "EU-03" },
            { "label": "AU-01", "value": "AU-01" }
          ],
          "default": "US-01",
          "note": "Find your REST Endpoint under Settings → APIs and Identifiers (e.g. rest.iad-03.braze.com → US-03)."
        }
      ]
    }
  }
}
