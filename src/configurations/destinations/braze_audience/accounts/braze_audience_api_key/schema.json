{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["restApiKey"],
    "properties": {
      "restApiKey": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|^(.{1,200})$"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["dataCenter"],
    "properties": {
      "dataCenter": {
        "type": "string",
        "enum": [
          "US-01",
          "US-02",
          "US-03",
          "US-04",
          "US-05",
          "US-06",
          "US-07",
          "US-08",
          "EU-01",
          "EU-02",
          "EU-03",
          "AU-01"
        ],
        "default": "US-01"
      }
    }
  }
}
