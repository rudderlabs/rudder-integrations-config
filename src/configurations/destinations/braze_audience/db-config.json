{
  "name": "BRAZE_AUDIENCE",
  "displayName": "Braze Audiences",
  "version": "1.0",
  "config": {
    "supportedAccountDefinitions": {
      "rudderAccountId": ["DESTINATION_BRAZE_AUDIENCE_API_KEY"]
    },
    "syncBehaviours": ["mirror"],
    "supportsVisualMapperV2": true,
    "isAudienceSupported": true,
    "transformAtV1": "router",
    "supportedSourceTypes": ["warehouse"],
    "supportedMessageTypes": {
      "cloud": ["record"]
    },
    "supportedConnectionModes": {
      "warehouse": ["cloud"]
    },
    "destConfig": {
      "defaultConfig": ["rudderAccountId", "restApiKey", "dataCenter"],
      "warehouse": ["connectionMode"]
    },
    "secretKeys": ["restApiKey"]
  },
  "options": {
    "isBeta": true
  }
}
