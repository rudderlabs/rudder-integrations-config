{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["clientSecret"],
    "properties": {
      "clientSecret": {
        "type": "string",
        "pattern": "^.{1,500}$",
        "errorMessage": "Enter a client secret between 1 and 500 characters"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["tokenUrl", "clientId"],
    "properties": {
      "tokenUrl": {
        "type": "string",
        "pattern": "^https://(?!(?:[A-Za-z0-9-]{1,63}\\.)*[Nn][Gg][Rr][Oo][Kk]\\.[Ii][Oo](?::|/|$))(?!(?:[A-Za-z0-9-]{1,63}\\.)*[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt](?::|/|$))([a-zA-Z0-9-]{1,63}\\.)+[a-zA-Z]{2,}(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]\\d{4}|[1-9]\\d{1,3}))?(/[^?#\\s]*)?$",
        "errorMessage": "Enter an HTTPS token URL without query parameters or fragments; use Extra token parameters"
      },
      "clientId": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a client ID between 1 and 200 characters"
      },
      "scopes": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "pattern": "^[^\\s,]{1,200}$"
        }
      },
      "scopeSeparator": {
        "type": "string",
        "enum": ["space", "comma"],
        "default": "space"
      },
      "extraTokenParams": {
        "type": "string",
        "pattern": "^.{0,2000}$",
        "errorMessage": "Enter token parameters up to 2000 characters"
      },
      "tokenAuthMethod": {
        "type": "string",
        "enum": ["client_secret_basic", "client_secret_post"],
        "default": "client_secret_basic"
      }
    }
  }
}
