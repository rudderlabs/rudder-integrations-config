{
  "uiConfig": {
    "name": "OAuth (Client Credentials)",
    "description": "Connect using the OAuth 2.0 Client Credentials flow",
    "icon": "key",
    "recommended": false,
    "form": {
      "title": "Create a Client Credentials account",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Custom Activation production",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "Token URL",
          "placeholder": "e.g: https://api.example.com/oauth/token",
          "key": ["options", "tokenUrl"],
          "note": "Enter the token endpoint without query parameters. Use Extra token parameters for additional form values."
        },
        {
          "component": "textField",
          "label": "Client ID",
          "placeholder": "Enter your OAuth client ID",
          "key": ["options", "clientId"]
        },
        {
          "component": "textField",
          "label": "Client secret",
          "placeholder": "Enter your OAuth client secret",
          "key": ["options", "clientSecret"],
          "secret": true
        },
        {
          "component": "tagField",
          "label": "Scopes",
          "placeholder": "e.g: read",
          "key": ["options", "scopes"],
          "optional": true,
          "note": "Add each scope as a separate tag."
        },
        {
          "component": "selectField",
          "label": "Scope separator",
          "key": ["options", "scopeSeparator"],
          "options": [
            { "label": "Space (most providers)", "value": "space" },
            { "label": "Comma (e.g. Pinterest)", "value": "comma" }
          ],
          "default": "space"
        },
        {
          "component": "textField",
          "label": "Extra token parameters",
          "placeholder": "e.g: audience=https%3A%2F%2Fapi.example.com",
          "key": ["options", "extraTokenParams"],
          "optional": true,
          "note": "Enter additional URL-encoded form parameters for token requests."
        },
        {
          "component": "selectField",
          "label": "Token authentication method",
          "key": ["options", "tokenAuthMethod"],
          "options": [
            {
              "label": "Authorization header (Basic)",
              "value": "client_secret_basic"
            },
            {
              "label": "Request body",
              "value": "client_secret_post"
            }
          ],
          "default": "client_secret_basic"
        }
      ]
    }
  }
}
