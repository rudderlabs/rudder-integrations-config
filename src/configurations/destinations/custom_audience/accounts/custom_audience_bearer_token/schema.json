{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["bearerToken"],
    "properties": {
      "bearerToken": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter a bearer token between 1 and 500 characters"
      }
    }
  }
}
