{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["basicAuthPassword"],
    "properties": {
      "basicAuthPassword": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter a password between 1 and 500 characters"
      }
    },
    "errorMessage": {
      "required": {
        "basicAuthPassword": "Enter a password"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["basicAuthUserName"],
    "properties": {
      "basicAuthUserName": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter a username between 1 and 200 characters"
      }
    },
    "errorMessage": {
      "required": {
        "basicAuthUserName": "Enter a username"
      }
    }
  }
}
