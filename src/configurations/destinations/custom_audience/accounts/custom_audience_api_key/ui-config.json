{
  "uiConfig": {
    "name": "API Key",
    "icon": "key",
    "description": "Authenticate Custom Activation requests with an API key header",
    "recommended": false,
    "form": {
      "title": "Create an API Key account",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Custom Activation production",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "API key name",
          "placeholder": "e.g: X-API-Key",
          "key": ["options", "apiKeyName"]
        },
        {
          "component": "textField",
          "label": "API key value",
          "placeholder": "Enter your API key value",
          "key": ["options", "apiKeyValue"],
          "secret": true
        }
      ]
    }
  }
}
