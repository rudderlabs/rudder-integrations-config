{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKeyValue"],
    "properties": {
      "apiKeyValue": {
        "type": "string",
        "pattern": "^(?=.{1,500}$).*\\S.*$",
        "errorMessage": "Enter an API key value between 1 and 500 characters"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKeyName"],
    "properties": {
      "apiKeyName": {
        "type": "string",
        "pattern": "^(?=.{1,200}$).*\\S.*$",
        "errorMessage": "Enter an API key name between 1 and 200 characters"
      }
    }
  }
}
