{
  "uiConfig": {
    "name": "API Key",
    "icon": "key",
    "description": "Authenticate using a Gainsight PX REST API key",
    "recommended": true,
    "form": {
      "title": "Connect your Gainsight PX subscription",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Gainsight PX prod",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "REST API key",
          "placeholder": "e.g: 1a2b3c4d-...",
          "key": ["options", "apiKey"],
          "secret": true,
          "note": "Create it in Gainsight PX under Administration › REST API with Read and Write permission."
        },
        {
          "component": "selectField",
          "label": "Data center",
          "key": ["options", "dataCenter"],
          "options": [
            { "label": "US", "value": "US" },
            { "label": "EU", "value": "EU" },
            { "label": "US2", "value": "US2" }
          ],
          "default": "US",
          "note": "From your PX URL: app → US, app-eu → EU, app-us2 → US2"
        }
      ]
    }
  }
}
