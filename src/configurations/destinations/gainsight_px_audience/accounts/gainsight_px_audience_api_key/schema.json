{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "^[!-~]{1,200}$",
        "errorMessage": "Enter a Gainsight PX REST API key of up to 200 characters, with no spaces"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["dataCenter"],
    "properties": {
      "dataCenter": {
        "type": "string",
        "enum": ["US", "EU", "US2"],
        "default": "US"
      }
    }
  }
}
