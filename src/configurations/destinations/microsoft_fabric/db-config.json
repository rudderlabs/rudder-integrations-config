{
  "name": "MICROSOFT_FABRIC",
  "displayName": "Microsoft Fabric",
  "version": "1.0",
  "category": "warehouse",
  "config": {
    "supportedAccountDefinitions": {
      "rudderAccountId": ["DESTINATION_MICROSOFT_FABRIC_SERVICE_PRINCIPAL"]
    },
    "transformAtV1": "processor",
    "saveDestinationResponse": true,
    "supportedSourceTypes": [
      "android",
      "androidKotlin",
      "ios",
      "iosSwift",
      "web",
      "unity",
      "amp",
      "cloud",
      "reactnative",
      "cloudSource",
      "flutter",
      "cordova",
      "shopify"
    ],
    "destConfig": {
      "defaultConfig": [
        "rudderAccountId",
        "tenantId",
        "clientId",
        "clientSecret",
        "host",
        "port",
        "database",
        "fabricWorkspaceId",
        "lakehouseId",
        "namespace",
        "syncFrequency",
        "syncStartAt",
        "excludeWindow",
        "preferAppend",
        "skipTracksTable",
        "skipUsersTable",
        "cleanupObjectStorageFiles"
      ],
      "android": ["connectionMode", "consentManagement"],
      "androidKotlin": ["connectionMode", "consentManagement"],
      "ios": ["connectionMode", "consentManagement"],
      "iosSwift": ["connectionMode", "consentManagement"],
      "web": ["connectionMode", "consentManagement"],
      "unity": ["connectionMode", "consentManagement"],
      "amp": ["connectionMode", "consentManagement"],
      "cloud": ["connectionMode", "consentManagement"],
      "reactnative": ["connectionMode", "consentManagement"],
      "cloudSource": ["connectionMode", "consentManagement"],
      "flutter": ["connectionMode", "consentManagement"],
      "cordova": ["connectionMode", "consentManagement"],
      "shopify": ["connectionMode", "consentManagement"]
    },
    "secretKeys": ["clientSecret"],
    "supportedConnectionModes": {
      "android": ["cloud"],
      "androidKotlin": ["cloud"],
      "ios": ["cloud"],
      "iosSwift": ["cloud"],
      "web": ["cloud"],
      "unity": ["cloud"],
      "amp": ["cloud"],
      "cloud": ["cloud"],
      "reactnative": ["cloud"],
      "cloudSource": ["cloud"],
      "flutter": ["cloud"],
      "cordova": ["cloud"],
      "shopify": ["cloud"]
    }
  },
  "options": {
    "isBeta": true,
    "hidden": {
      "gate": {
        "flags": [{ "name": "AMP_enable-microsoft-fabric-destination", "value": false }]
      }
    }
  }
}
