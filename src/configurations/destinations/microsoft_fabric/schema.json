{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["rudderAccountId", "host", "port", "database", "fabricWorkspaceId", "lakehouseId"],
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rudderAccountId": {
        "type": "string"
      },
      "host": {
        "type": "string",
        "pattern": "^(?=.{1,255}$)([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])\\.)+[Ff][Aa][Bb][Rr][Ii][Cc]\\.[Mm][Ii][Cc][Rr][Oo][Ss][Oo][Ff][Tt]\\.[Cc][Oo][Mm]$"
      },
      "port": {
        "type": "string",
        "pattern": "^[0-9]{1,5}$"
      },
      "database": {
        "type": "string",
        "pattern": "^.{1,128}$"
      },
      "fabricWorkspaceId": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
      },
      "lakehouseId": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
      },
      "namespace": {
        "type": "string",
        "pattern": "^.{0,128}$",
        "rs-immutable": true
      },
      "syncFrequency": {
        "type": "string",
        "enum": ["30", "60", "180", "360", "720", "1440"],
        "default": "180"
      },
      "syncStartAt": {
        "type": "string"
      },
      "excludeWindow": {
        "type": "object",
        "properties": {
          "excludeWindowStartTime": {
            "type": "string"
          },
          "excludeWindowEndTime": {
            "type": "string"
          }
        },
        "required": ["excludeWindowStartTime", "excludeWindowEndTime"]
      },
      "preferAppend": {
        "type": "boolean",
        "default": true
      },
      "skipUsersTable": {
        "type": "boolean",
        "default": true
      },
      "skipTracksTable": {
        "type": "boolean",
        "default": false
      },
      "cleanupObjectStorageFiles": {
        "type": "boolean",
        "default": false
      },
      "allowUsersContextTraits": {
        "type": "boolean",
        "description": "Internal, immutable flag retained for backward compatibility. When false, context.traits.* fields are not promoted to top-level traits; they are stored only as context_traits_*.",
        "default": false,
        "rs-immutable": true
      },
      "underscoreDivideNumbers": {
        "type": "boolean",
        "description": "Internal, immutable flag retained for backward compatibility. When false, numeric suffixes in column names are preserved; for example v3 remains v3 instead of being split into v_3.",
        "default": false,
        "rs-immutable": true
      },
      "consentManagement": {
        "type": "object",
        "properties": {
          "android": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["custom", "iubenda", "ketch", "oneTrust"]
                },
                "consents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consent": {
                        "type": "string",
                        "pattern": "^(.{0,100})$"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provider": {
                        "const": "custom"
                      }
                    },
                    "required": ["provider"]
                  },
                  "then": {
                    "properties": {
                      "resolutionStrategy": {
                        "type": "string",
                        "enum": ["and", "or"]
                      }
                    },
                    "required": ["resolutionStrategy"]
                  }
                }
              ],
              "required": ["provider"]
            },
            "uniqueItemProperties": ["provider"],
            "errorMessage": {
              "uniqueItemProperties": "Only one consent management block can be configured per provider."
            }
          },
          "androidKotlin": {
            "type": "array",
            "items": {
