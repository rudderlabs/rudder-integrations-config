{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["clientSecret"],
    "properties": {
      "clientSecret": {
        "type": "string",
        "pattern": "^.{1,500}$",
        "errorMessage": "Enter a client secret"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["tenantId", "clientId"],
    "properties": {
      "tenantId": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
        "errorMessage": "Enter a valid tenant GUID"
      },
      "clientId": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
        "errorMessage": "Enter a valid client GUID"
      }
    }
  }
}
