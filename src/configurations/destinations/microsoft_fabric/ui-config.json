{
  "uiConfig": {
    "baseTemplate": [
      {
        "title": "Initial setup",
        "note": "Review how this destination is set up",
        "sections": [
          {
            "groups": [
              {
                "title": "Connection settings",
                "note": "Select the Microsoft Entra service principal used for Fabric Warehouse and OneLake",
                "icon": "settings",
                "fields": [
                  {
                    "type": "accountManagementInput",
                    "label": "Microsoft Fabric account",
                    "configKey": "rudderAccountId",
                    "required": true
                  }
                ]
              },
              {
                "title": "Warehouse connection",
                "note": "Enter the complete Fabric Warehouse SQL connection details",
                "icon": "settings",
                "fields": [
                  {
                    "type": "textInput",
                    "label": "Host",
                    "labelNote": "Complete host used for Fabric SQL and OneLake access",
                    "configKey": "host",
                    "regex": "^.{1,200}$",
                    "regexErrorMessage": "Enter a host",
                    "placeholder": "e.g: your-fabric-host.example.com",
                    "required": true
                  },
                  {
                    "type": "textInput",
                    "label": "Port",
                    "configKey": "port",
                    "regex": "^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]\\d{4}|[1-9]\\d{0,3})$",
                    "regexErrorMessage": "Enter a valid port",
                    "placeholder": "1433",
                    "default": "1433",
                    "required": true
                  },
                  {
                    "type": "textInput",
                    "label": "Database",
                    "labelNote": "Fabric Warehouse database or item name",
                    "configKey": "database",
                    "regex": "^.{1,100}$",
                    "regexErrorMessage": "Enter a database name",
                    "placeholder": "e.g: analytics_warehouse",
                    "required": true
                  }
                ]
              },
              {
                "title": "OneLake staging",
                "note": "Use a customer-owned Lakehouse in the same region as the target Warehouse",
                "icon": "settings",
                "fields": [
                  {
                    "type": "textInput",
                    "label": "Fabric workspace ID",
                    "labelNote": "GUID of the source workspace containing the staging Lakehouse",
                    "configKey": "fabricWorkspaceId",
                    "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
                    "regexErrorMessage": "Enter a valid workspace GUID",
                    "placeholder": "e.g: 12345678-1234-4123-8123-123456789abc",
                    "required": true
                  },
                  {
                    "type": "textInput",
                    "label": "Lakehouse ID",
                    "labelNote": "GUID of the customer-owned staging Lakehouse",
                    "configKey": "lakehouseId",
                    "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
                    "regexErrorMessage": "Enter a valid Lakehouse GUID",
                    "placeholder": "e.g: 12345678-1234-4123-8123-123456789abc",
                    "required": true
                  }
                ]
              }
            ]
          },
          {
            "groups": [
              {
                "title": "Connection mode",
                "note": [
                  "Update how you want to route events from your source to destination. ",
                  {
                    "text": "Get help deciding",
                    "link": "https://www.rudderstack.com/docs/destinations/rudderstack-connection-modes/"
                  }
                ],
                "icon": "sliders",
                "fields": []
              }
            ]
          }
        ]
      },
      {
        "title": "Configuration settings",
        "note": "Manage the settings for your destination",
        "sections": [
          {
            "title": "Sync schedule",
            "note": "Configure when RudderStack syncs data to Microsoft Fabric",
            "icon": "clock",
            "groups": [
              {
                "title": "Schedule settings",
                "fields": [
                  {
                    "type": "singleSelect",
                    "label": "Sync frequency",
                    "configKey": "syncFrequency",
                    "options": [
                      {
                        "label": "Every 5 minutes",
                        "value": "5",
                        "featureFlag": "AMP_enable-high-granularity-wh-syncs"
                      },
                      {
                        "label": "Every 10 minutes",
                        "value": "10",
                        "featureFlag": "AMP_enable-high-granularity-wh-syncs"
                      },
                      {
                        "label": "Every 15 minutes",
                        "value": "15",
                        "featureFlag": "AMP_enable-high-granularity-wh-syncs"
                      },
                      {
                        "label": "Every 30 minutes",
                        "value": "30"
                      },
                      {
                        "label": "Every 1 hour",
                        "value": "60"
                      },
                      {
                        "label": "Every 3 hours",
                        "value": "180"
                      },
                      {
                        "label": "Every 6 hours",
                        "value": "360"
                      },
                      {
                        "label": "Every 12 hours",
                        "value": "720"
                      },
                      {
                        "label": "Every 24 hours",
                        "value": "1440"
                      }
                    ],
                    "default": "180",
                    "required": false
                  },
                  {
                    "type": "timePicker",
                    "label": "Sync starting at (Optional)",
                    "configKey": "syncStartAt",
                    "options": {
                      "omitSeconds": true,
                      "minuteStep": 15
                    },
                    "required": false,
                    "footerNote": "Specify the time in UTC"
                  },
                  {
                    "type": "timeRangePicker",
                    "label": "Exclude window (Optional)",
                    "configKey": "excludeWindow",
                    "startTime": {
                      "label": "Start time",
                      "value": "excludeWindowStartTime"
                    },
                    "endTime": {
                      "label": "End time",
                      "value": "excludeWindowEndTime"
                    },
                    "options": {
                      "omitSeconds": true,
                      "minuteStep": 1
                    },
                    "required": false,
                    "footerNote": "Specify the time in UTC"
                  }
                ]
              }
            ]
          },
          {
            "title": "Destination settings",
            "note": "Configure warehouse load and cleanup behavior",
            "icon": "settings",
            "groups": [
              {
                "title": "Warehouse behavior",
                "fields": [
                  {
                    "type": "textInput",
                    "label": "Namespace",
                    "labelNote": "Schema name where RudderStack creates warehouse tables",
                    "configKey": "namespace",
                    "regex": "^((?!pg_|PG_|pG_|Pg_).{0,64})$",
                    "regexErrorMessage": "Enter a valid namespace",
                    "placeholder": "e.g: rudderstack",
                    "required": false,
                    "footerNote": "Defaults to the source name",
                    "immutable": true
                  },
                  {
                    "type": "checkbox",
                    "label": "Warehouse append",
                    "configKey": "preferAppend",
                    "default": true,
                    "footerNote": "Disable to use merge operations for non-duplicate data when warehouse upload semantics allow it"
                  },
                  {
                    "type": "checkbox",
                    "label": "Skip Users table",
                    "configKey": "skipUsersTable",
                    "default": true,
                    "footerNote": "Disable to create and maintain the Users table"
                  },
                  {
                    "type": "checkbox",
                    "label": "Skip Tracks table",
                    "configKey": "skipTracksTable",
                    "default": false,
                    "footerNote": "Enable to skip sending event data to the tracks table"
                  },
                  {
                    "type": "checkbox",
                    "label": "Clean up OneLake files after successful sync",
                    "configKey": "cleanupObjectStorageFiles",
                    "default": false
                  }
                ]
              }
            ]
          },
          {
            "id": "consentSettings",
            "title": "Consent settings",
            "note": "Configure consent settings for each provider here",
            "icon": "settings",
            "groups": []
          }
        ]
      }
    ],
    "sdkTemplate": {
      "title": "SDK settings",
      "note": "not visible in the ui",
      "fields": []
    },
    "consentSettingsTemplate": {
      "title": "Consent settings",
      "note": "not visible in the ui",
      "fields": [
        {
          "type": "dynamicCustomForm",
          "configKey": "consentManagement",
          "default": [],
          "additionalProperties": false,
          "rowFields": [
            {
              "type": "singleSelect",
              "label": "Consent management provider",
              "configKey": "provider",
              "options": [
                {
                  "label": "Custom",
                  "value": "custom"
                },
                {
                  "label": "iubenda",
                  "value": "iubenda"
                },
                {
                  "label": "Ketch",
                  "value": "ketch"
                },
                {
                  "label": "OneTrust",
                  "value": "oneTrust"
                }
              ],
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "the required consent logic",
              "configKey": "resolutionStrategy",
              "options": [
                {
                  "label": "AND",
                  "value": "and"
                },
                {
                  "label": "OR",
                  "value": "or"
                }
              ],
              "required": true,
              "variant": "badge",
              "preRequisites": {
                "fields": [
                  {
                    "configKey": "provider",
                    "value": "custom"
                  }
                ]
              }
            },
            {
              "type": "tagInput",
              "label": "Enter consent category IDs",
              "note": "Input your consent category IDs by pressing 'Enter' after each entry. We recommend using IDs instead of names as IDs are unique and less likely to change over time, making them a more reliable choice.",
              "configKey": "consents",
              "tagKey": "consent",
              "regex": "^(.{0,100})$",
              "placeholder": "e.g: Marketing",
              "default": [
                {
                  "consent": ""
                }
              ]
            }
          ],
          "uniqueRowFields": ["provider"]
        }
      ]
    }
  }
}
