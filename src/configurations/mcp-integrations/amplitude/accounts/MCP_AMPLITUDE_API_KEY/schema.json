{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "pattern": "^(.{1,500})$"
      }
    },
    "additionalProperties": false
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["region"],
    "properties": {
      "region": {
        "type": "string",
        "enum": ["US", "EU"],
        "default": "US",
        "description": "Amplitude region for MCP API requests."
      }
    },
    "additionalProperties": false
  }
}
