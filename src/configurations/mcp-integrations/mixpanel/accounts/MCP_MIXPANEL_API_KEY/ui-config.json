{
  "uiConfig": {
    "name": "API Key",
    "description": "Connect Mixpanel MCP with service-account credentials.",
    "icon": "key",
    "recommended": false,
    "form": {
      "title": "Connect Mixpanel MCP with service-account credentials",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Mixpanel production",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "Project ID",
          "placeholder": "e.g: 1234567",
          "key": ["options", "projectId"],
          "note": "Mixpanel project ID for the project exposed through MCP."
        },
        {
          "component": "selectField",
          "label": "Region",
          "key": ["options", "region"],
          "options": [
            {
              "label": "US",
              "value": "US"
            },
            {
              "label": "EU",
              "value": "EU"
            }
          ],
          "default": "US",
          "note": "Choose the Mixpanel data center for this MCP account."
        },
        {
          "component": "textField",
          "label": "Service Account Username",
          "placeholder": "e.g: svc-user-123",
          "key": ["options", "serviceAccountUsername"],
          "secret": true,
          "note": "Mixpanel service-account username. See https://docs.mixpanel.com/docs/tracking/how-tos/api-credentials."
        },
        {
          "component": "textField",
          "label": "Service Account Secret",
          "placeholder": "e.g: mxp_secret_...",
          "key": ["options", "serviceAccountSecret"],
          "secret": true,
          "note": "Secret for the Mixpanel service account."
        }
      ]
    }
  }
}
