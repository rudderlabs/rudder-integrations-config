{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["serviceAccountUsername", "serviceAccountSecret"],
    "properties": {
      "serviceAccountUsername": {
        "type": "string",
        "pattern": "^(.{1,500})$"
      },
      "serviceAccountSecret": {
        "type": "string",
        "pattern": "^(.{1,500})$"
      }
    },
    "additionalProperties": false
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["projectId", "region"],
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[0-9]{1,30}$",
        "description": "Mixpanel project ID."
      },
      "region": {
        "type": "string",
        "enum": ["US", "EU"],
        "default": "US",
        "description": "Mixpanel region for MCP API requests."
      }
    },
    "additionalProperties": false
  }
}
