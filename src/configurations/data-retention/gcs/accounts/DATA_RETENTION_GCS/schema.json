{
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["bucketName"],
    "properties": {
      "bucketName": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{1,220}[a-z0-9]$",
        "description": "Name of the GCS bucket where data is retained."
      },
      "prefix": {
        "type": "string",
        "description": "Optional path prefix within the bucket."
      }
    }
  },
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["credentials"],
    "properties": {
      "credentials": {
        "type": "string",
        "pattern": "^[\\s\\S]+$",
        "description": "GCP service account key JSON."
      }
    }
  }
}
