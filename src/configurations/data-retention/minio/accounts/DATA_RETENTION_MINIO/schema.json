{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["accessKeyID", "secretAccessKey"],
    "properties": {
      "accessKeyID": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|^(.{1,100})$"
      },
      "secretAccessKey": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|^(.{1,100})$"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["endPoint", "bucketName"],
    "properties": {
      "endPoint": {
        "type": "string",
        "pattern": "^(.{1,100})$",
        "description": "MinIO server endpoint, e.g. play.min.io:9000."
      },
      "bucketName": {
        "type": "string",
        "pattern": "^(.{1,100})$",
        "description": "Name of the MinIO bucket where data is retained."
      },
      "prefix": {
        "type": "string",
        "description": "Optional path prefix within the bucket."
      },
      "useSSL": {
        "type": "string",
        "enum": ["true", "false"],
        "default": "true",
        "description": "Use SSL/TLS when connecting to the MinIO endpoint."
      }
    }
  }
}
