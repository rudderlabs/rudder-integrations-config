{
  "uiConfig": {
    "name": "Access Keys",
    "icon": "key",
    "description": "Grant access to your MinIO bucket using access keys",
    "recommended": true,
    "form": {
      "title": "Connect your MinIO bucket",
      "fields": [
        {
          "component": "textField",
          "label": "Account name",
          "placeholder": "e.g: Data Retention MinIO prod",
          "key": "name"
        },
        {
          "component": "textField",
          "label": "Access Key ID",
          "placeholder": "e.g: Q3AM3UQ867SPQQA43P2F",
          "key": ["options", "accessKeyID"],
          "secret": true,
          "note": "MinIO access key ID with write access to the bucket."
        },
        {
          "component": "textField",
          "label": "Secret Access Key",
          "placeholder": "e.g: zuf+tfteSlswRu7BJ86wekitnifILbZam1KYY3TG",
          "key": ["options", "secretAccessKey"],
          "secret": true,
          "note": "MinIO secret access key paired with the access key ID."
        },
        {
          "component": "textField",
          "label": "MinIO endpoint",
          "placeholder": "e.g: play.min.io:9000",
          "key": ["options", "endPoint"],
          "note": "MinIO server endpoint."
        },
        {
          "component": "textField",
          "label": "Bucket name",
          "placeholder": "e.g: my-data-retention-bucket",
          "key": ["options", "bucketName"],
          "note": "Name of the MinIO bucket where data is retained."
        },
        {
          "component": "textField",
          "label": "Prefix",
          "placeholder": "e.g: rudder",
          "key": ["options", "prefix"],
          "optional": true,
          "note": "Optional path prefix within the bucket."
        },
        {
          "component": "selectField",
          "label": "Use SSL",
          "key": ["options", "useSSL"],
          "options": [
            {
              "label": "Enabled",
              "value": "true"
            },
            {
              "label": "Disabled",
              "value": "false"
            }
          ],
          "default": "true",
          "note": "Use SSL/TLS when connecting to the MinIO endpoint."
        }
      ]
    }
  }
}
