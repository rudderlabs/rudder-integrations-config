{
  "secretSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["accessKeyID", "accessKey"],
    "properties": {
      "accessKeyID": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|^(.{1,200})$"
      },
      "accessKey": {
        "type": "string",
        "pattern": "(^\\{\\{.*\\|\\|(.*)\\}\\}$)|^(.{1,200})$"
      }
    }
  },
  "optionsSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["bucketName"],
    "properties": {
      "bucketName": {
        "type": "string",
        "pattern": "^(?!.*\\.\\.)(?!.*\\.$)(?!^\\.)[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
        "description": "Name of the S3 bucket where data is retained."
      },
      "prefix": {
        "type": "string",
        "description": "Optional path prefix within the bucket."
      },
      "enableSSE": {
        "type": "string",
        "enum": ["true", "false"],
        "default": "false",
        "description": "Enable server-side encryption for objects written to the bucket."
      },
      "roleBasedAuth": {
        "type": "boolean",
        "description": "Selects assume-role authentication in the data plane. False for this access-key account definition."
      }
    }
  }
}
