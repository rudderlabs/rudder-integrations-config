[
  {
    "testTitle": "valid minimal config",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "properties.orderId",
      "eventMapping": [
        {
          "from": "Order Completed",
          "to": "order_created"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "valid standard mapping config",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "messageId",
      "defaultCurrency": "USD",
      "defaultActionSource": "website",
      "eventMapping": [
        {
          "from": "Product Viewed",
          "to": "contents_viewed",
          "conversionIdentifier": "properties.productId"
        },
        {
          "from": "Checkout Started",
          "to": "checkout_started",
          "conversionIdentifier": "properties.checkoutId"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "valid custom mapping config",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "messageId",
      "defaultActionSource": "app",
      "eventMapping": [
        {
          "from": "Qualified Lead",
          "to": "custom",
          "conversionIdentifier": "properties.leadId",
          "customEventName": "qualified_lead"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "missing required top-level fields",
    "config": {
      "defaultActionSource": "website"
    },
    "result": false,
    "err": [
      " must have required property 'apiKey'",
      " must have required property 'conversionIdentifier'",
      " must have required property 'eventMapping'"
    ]
  },
  {
    "testTitle": "invalid default action source",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "messageId",
      "defaultActionSource": "web",
      "eventMapping": [
        {
          "from": "Page Viewed",
          "to": "page_viewed"
        }
      ]
    },
    "result": false,
    "err": ["defaultActionSource must be equal to one of the allowed values"]
  },
  {
    "testTitle": "empty event mapping array",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "messageId",
      "eventMapping": []
    },
    "result": false,
    "err": ["eventMapping must NOT have fewer than 1 items"]
  },
  {
    "testTitle": "missing custom event name",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "messageId",
      "eventMapping": [
        {
          "from": "Qualified Lead",
          "to": "custom"
        }
      ]
    },
    "result": false,
    "err": [
      "eventMapping.0 must have required property 'customEventName'",
      "eventMapping.0 must match \"then\" schema"
    ]
  },
  {
    "testTitle": "duplicate from values in event mappings",
    "config": {
      "apiKey": "openai-api-key",
      "conversionIdentifier": "messageId",
      "eventMapping": [
        {
          "from": "Order Completed",
          "to": "order_created"
        },
        {
          "from": "Order Completed",
          "to": "checkout_started"
        }
      ]
    },
    "result": false,
    "err": [
      "eventMapping Each OpenAI Ads event mapping must have a unique RudderStack Event value."
    ]
  }
]
