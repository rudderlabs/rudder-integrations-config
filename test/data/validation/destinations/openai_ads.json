[
  {
    "testTitle": "valid minimal config",
    "config": {
      "apiKey": "openai-api-key",
      "eventMapping": [
        {
          "from": "Order Completed",
          "to": "order_created"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "valid standard mapping config",
    "config": {
      "apiKey": "openai-api-key",
      "defaultCurrency": "USD",
      "defaultActionSource": "web",
      "eventMapping": [
        {
          "from": "Product Viewed",
          "to": "contents_viewed",
          "deduplicationKey": "properties.productId"
        },
        {
          "from": "Checkout Started",
          "to": "checkout_started",
          "deduplicationKey": "properties.checkoutId"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "valid custom mapping config",
    "config": {
      "apiKey": "openai-api-key",
      "defaultActionSource": "mobile_app",
      "eventMapping": [
        {
          "from": "Qualified Lead",
          "to": "custom",
          "deduplicationKey": "properties.leadId",
          "customEventName": "qualified_lead"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "valid other default action source",
    "config": {
      "apiKey": "openai-api-key",
      "defaultActionSource": "other",
      "eventMapping": [
        {
          "from": "Trial Started",
          "to": "trial_started"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "missing required top-level fields",
    "config": {
      "defaultActionSource": "web"
    },
    "result": false,
    "err": [" must have required property 'apiKey'", " must have required property 'eventMapping'"]
  },
  {
    "testTitle": "invalid default action source",
    "config": {
      "apiKey": "openai-api-key",
      "defaultActionSource": "website",
      "eventMapping": [
        {
          "from": "Page Viewed",
          "to": "page_viewed"
        }
      ]
    },
    "result": false,
    "err": ["defaultActionSource must be equal to one of the allowed values"]
  },
  {
    "testTitle": "empty event mapping array",
    "config": {
      "apiKey": "openai-api-key",
      "eventMapping": []
    },
    "result": false,
    "err": ["eventMapping must NOT have fewer than 1 items"]
  },
  {
    "testTitle": "missing custom event name",
    "config": {
      "apiKey": "openai-api-key",
      "eventMapping": [
        {
          "from": "Qualified Lead",
          "to": "custom"
        }
      ]
    },
    "result": false,
    "err": [
      "eventMapping.0 must have required property 'customEventName'",
      "eventMapping.0 must match \"then\" schema"
    ]
  },
  {
    "testTitle": "duplicate from values in event mappings",
    "config": {
      "apiKey": "openai-api-key",
      "eventMapping": [
        {
          "from": "Order Completed",
          "to": "order_created"
        },
        {
          "from": "Order Completed",
          "to": "checkout_started"
        }
      ]
    },
    "result": false,
    "err": [
      "eventMapping Each OpenAI Ads event mapping must have a unique RudderStack Event value."
    ]
  },
  {
    "testTitle": "invalid deduplication key dot paths",
    "config": {
      "apiKey": "openai-api-key",
      "eventMapping": [
        {
          "from": "Order Completed",
          "to": "order_created",
          "deduplicationKey": "$.properties.id"
        },
        {
          "from": "Product Viewed",
          "to": "contents_viewed",
          "deduplicationKey": "properties.items[].orderId"
        }
      ]
    },
    "result": false,
    "err": [
      "eventMapping.0.deduplicationKey must match pattern \"^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$\"",
      "eventMapping.1.deduplicationKey must match pattern \"^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$\""
    ]
  }
]
