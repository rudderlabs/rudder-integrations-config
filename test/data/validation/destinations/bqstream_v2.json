[
  {
    "testTitle": "With full valid config",
    "config": {
      "project": "my-sample-project-19XX23",
      "location": "US",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "partitionColumn": "_PARTITIONTIME",
      "partitionType": "day",
      "skipTracksTable": false,
      "skipViews": false,
      "jsonPaths": "testMap.nestedMap, testArray"
    },
    "result": true
  },
  {
    "testTitle": "With minimal required config",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}"
    },
    "result": true
  },
  {
    "testTitle": "With namespace as env variable",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "env.RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}"
    },
    "result": true
  },
  {
    "testTitle": "With empty project",
    "config": {
      "project": "",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}"
    },
    "result": false,
    "err": ["project must match pattern \"^(.{1,100})$\""]
  },
  {
    "testTitle": "With empty credentials",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": ""
    },
    "result": false,
    "err": ["credentials must match pattern \".+\""]
  },
  {
    "testTitle": "Without project",
    "config": {
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}"
    },
    "result": false,
    "err": [" must have required property 'project'"]
  },
  {
    "testTitle": "Without namespace",
    "config": {
      "project": "my-sample-project-19XX23",
      "credentials": "{\"type\":\"service_account\"}"
    },
    "result": false,
    "err": [" must have required property 'namespace'"]
  },
  {
    "testTitle": "Without credentials",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE"
    },
    "result": false,
    "err": [" must have required property 'credentials'"]
  },
  {
    "testTitle": "With invalid namespace (reserved pg_ prefix)",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "pg_invalid",
      "credentials": "{\"type\":\"service_account\"}"
    },
    "result": false,
    "err": [
      "namespace must match pattern \"(^\\{\\{.*\\|\\|(.*)\\}\\}$)|(^env[.].+)|^((?!pg_|PG_|pG_|Pg_).{1,64})$\""
    ]
  },
  {
    "testTitle": "With invalid partitionColumn value",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "partitionColumn": "invalid_column"
    },
    "result": false,
    "err": ["partitionColumn must be equal to one of the allowed values"]
  },
  {
    "testTitle": "With invalid partitionType value",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "partitionType": "week"
    },
    "result": false,
    "err": ["partitionType must be equal to one of the allowed values"]
  },
  {
    "testTitle": "With non-boolean skipTracksTable",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "skipTracksTable": "yes"
    },
    "result": false,
    "err": ["skipTracksTable must be boolean"]
  },
  {
    "testTitle": "With valid multiple consent management providers config",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "consentManagement": {
        "web": [
          {
            "provider": "custom",
            "consents": [
              {
                "consent": "Marketing"
              }
            ],
            "resolutionStrategy": "or"
          },
          {
            "provider": "oneTrust",
            "consents": [
              {
                "consent": "Marketing"
              }
            ]
          },
          {
            "provider": "ketch",
            "consents": []
          },
          {
            "provider": "iubenda",
            "consents": [
              {
                "consent": "1"
              },
              {
                "consent": "4"
              }
            ]
          }
        ]
      }
    },
    "result": true
  },
  {
    "testTitle": "With consent management custom provider config and invalid resolutionStrategy value",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "consentManagement": {
        "android": [
          {
            "provider": "custom",
            "resolutionStrategy": "nor"
          }
        ]
      }
    },
    "result": false,
    "err": [
      "consentManagement.android.0.resolutionStrategy must be equal to one of the allowed values",
      "consentManagement.android.0 must match \"then\" schema"
    ]
  },
  {
    "testTitle": "With consent management custom provider config and no resolutionStrategy value",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "consentManagement": {
        "android": [
          {
            "provider": "custom"
          }
        ]
      }
    },
    "result": false,
    "err": [
      "consentManagement.android.0 must have required property 'resolutionStrategy'",
      "consentManagement.android.0 must match \"then\" schema"
    ]
  },
  {
    "testTitle": "With consent management OneTrust provider config and no resolutionStrategy value",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "{\"type\":\"service_account\"}",
      "consentManagement": {
        "android": [
          {
            "provider": "oneTrust"
          }
        ]
      }
    },
    "result": true
  },
  {
    "testTitle": "With consent management custom provider config invalid provider value",
    "config": {
      "project": "my-sample-project-19XX23",
      "namespace": "RUDDER_NAMESPACE",
      "credentials": "dummyCredentials",
      "consentManagement": {
        "android": [
          {
            "provider": "dummyProvider"
          }
        ]
      }
    },
    "result": false,
    "err": ["consentManagement.android.0.provider must be equal to one of the allowed values"]
  }
]
