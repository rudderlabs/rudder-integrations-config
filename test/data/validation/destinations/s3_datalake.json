      "accessKey": "",
      "syncFrequency": "30",
      "region": "us-east-1",
      "consentManagement": {
        "web": [
          {
            "provider": "custom",
            "consents": [
              {
                "consent": "Marketing"
              }
            ],
            "resolutionStrategy": "or"
          },
          {
            "provider": "oneTrust",
            "consents": [
              {
                "consent": "Marketing"
              }
            ]
          },
          {
            "provider": "ketch",
            "consents": []
          },
          {
            "provider": "iubenda",
            "consents": [
              {
                "consent": "1"
              },
              {
                "consent": "4"
              }
            ]
          }
        ]
      }
    },
    "result": true
  },
