[
  {
    "testTitle": "valid minimal config with linked account",
    "config": { "rudderAccountId": "account_123" },
    "result": true
  },
  {
    "testTitle": "valid empty event mappings",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": []
    },
    "result": true
  },
  {
    "testTitle": "valid event mapping",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": [
        {
          "from": "Order Completed",
          "to": "purchase"
        }
      ]
    },
    "result": true
  },
  {
    "testTitle": "valid cloud connection mode and consent management",
    "config": {
      "rudderAccountId": "account_123",
      "connectionMode": {
        "web": "cloud",
        "androidKotlin": "cloud",
        "cloud": "cloud"
      },
      "consentManagement": {
        "web": [
          {
            "provider": "custom",
            "resolutionStrategy": "and",
            "consents": [{ "consent": "Marketing" }]
          }
        ],
        "cloud": [
          {
            "provider": "oneTrust",
            "consents": [{ "consent": "C0001" }]
          }
        ]
      }
    },
    "result": true
  },
  {
    "testTitle": "invalid missing linked account",
    "config": {},
    "result": false,
    "err": [" must have required property 'rudderAccountId'"]
  },
  {
    "testTitle": "invalid empty linked account",
    "config": { "rudderAccountId": "" },
    "result": false,
    "err": ["rudderAccountId must match pattern \"^.{1,100}$\""]
  },
  {
    "testTitle": "invalid device connection mode",
    "config": {
      "rudderAccountId": "account_123",
      "connectionMode": { "web": "device" }
    },
    "result": false,
    "err": ["connectionMode.web must be equal to one of the allowed values"]
  },
  {
    "testTitle": "invalid destination-level account credentials",
    "config": {
      "rudderAccountId": "account_123",
      "serverToServerKey": "synthetic-key",
      "serverToServerSecret": "synthetic-secret"
    },
    "result": false,
    "err": [" must NOT have additional properties", " must NOT have additional properties"]
  },
  {
    "testTitle": "invalid event mapping key spelling",
    "config": { "rudderAccountId": "account_123", "eventMapping": [] },
    "result": false,
    "err": [" must NOT have additional properties"]
  },
  {
    "testTitle": "invalid duplicate event mapping from rows",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": [
        { "from": "Order Completed", "to": "purchase" },
        { "from": "Order Completed", "to": "conversion" }
      ]
    },
    "result": false,
    "err": [
      "eventsMapping Only one Rokt conversion type can be configured per RudderStack event name."
    ]
  },
  {
    "testTitle": "invalid blank event mapping source",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": [{ "from": "", "to": "purchase" }]
    },
    "result": false,
    "err": ["eventsMapping.0.from must match pattern \"^(.{1,100})$\""]
  },
  {
    "testTitle": "invalid blank Rokt conversion type",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": [{ "from": "Order Completed", "to": "" }]
    },
    "result": false,
    "err": ["eventsMapping.0.to must match pattern \"^(.{1,100})$\""]
  },
  {
    "testTitle": "invalid extra event mapping property",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": [{ "from": "Order Completed", "to": "purchase", "enabled": true }]
    },
    "result": false,
    "err": ["eventsMapping.0 must NOT have additional properties"]
  },
  {
    "testTitle": "invalid over-length event mapping source",
    "config": {
      "rudderAccountId": "account_123",
      "eventsMapping": [
        {
          "from": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "to": "purchase"
        }
      ]
    },
    "result": false,
    "err": ["eventsMapping.0.from must match pattern \"^(.{1,100})$\""]
  },
  {
    "testTitle": "invalid event filtering setting",
    "config": { "rudderAccountId": "account_123", "eventFilteringOption": "disable" },
    "result": false,
    "err": [" must NOT have additional properties"]
  },
  {
    "testTitle": "invalid environment setting",
    "config": { "rudderAccountId": "account_123", "environment": "production" },
    "result": false,
    "err": [" must NOT have additional properties"]
  },
  {
    "testTitle": "invalid region setting",
    "config": { "rudderAccountId": "account_123", "region": "US1" },
    "result": false,
    "err": [" must NOT have additional properties"]
  },
  {
    "testTitle": "invalid device SDK setting",
    "config": { "rudderAccountId": "account_123", "useNativeSDK": true },
    "result": false,
    "err": [" must NOT have additional properties"]
  }
]
