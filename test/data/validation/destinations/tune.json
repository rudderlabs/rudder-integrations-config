[
  {
    "testTitle": "With all valid fields",
    "config": {
      "connectionMode": {
        "web": "cloud"
      },
      "consentManagement": {},
      "oneTrustCookieCategories": {},
      "ketchConsentPurposes": {},
      "subdomain": "demo",
      "tuneEvents": [
        {
          "eventName": "product added",
          "standardMapping": [
            {
              "to": "aff_id",
              "from": "affId"
            },
            {
              "to": "transaction_id",
              "from": "transactionId"
            }
          ],
          "advSubIdMapping": [
            {
              "from": "purchase event",
              "to": "adv_sub2"
            }
          ],
          "advUniqueIdMapping": [
            {
              "from": "oder completed",
              "to": "adv_unique3"
            }
          ]
        }
      ]
    },
    "result": true
  },
