[
  {
    "testTitle": "Account authentication with request mappings and batching",
    "config": {
      "apiUrl": "http://sample.com/api/hooks/{{$.traits.userId}}/url/{{$.properties.event}}",
      "method": "POST",
      "format": "JSON",
      "http-connectionMode": "cloud",
      "connectionMode": {
        "cloud": "cloud"
      },
      "consentManagement": {},
      "isBatchingEnabled": true,
      "maxBatchSize": "10",
      "headers": [
        {
          "to": "val",
          "from": "adfg"
        },
        {
          "to": "val2",
          "from": "2"
        },
        {
          "to": "auth",
          "from": "$.properties.testProp"
        }
      ],
      "queryParams": [
        {
          "from": "$.q1",
          "to": "'val1'"
        }
      ],
      "propertiesMapping": [
        {
          "from": "$.properties.key1",
          "to": "$.events.key2"
        }
      ],
      "authenticationEnabled": true,
      "rudderAccountId": "http-account-1"
    },
    "result": true
  },
  {
    "testTitle": "Account authentication without batching",
    "config": {
      "apiUrl": "http://sample.com/api/hooks/url",
      "method": "POST",
      "format": "JSON",
      "http-connectionMode": "cloud",
      "connectionMode": {
        "cloud": "cloud"
      },
      "consentManagement": {},
      "isBatchingEnabled": false,
      "authenticationEnabled": true,
      "rudderAccountId": "http-account-1"
    },
    "result": true
  },
  {
    "testTitle": "With invalid max batch size",
    "config": {
      "apiUrl": "http://sample.com/api/hooks/url",
      "method": "POST",
      "format": "JSON",
      "isBatchingEnabled": true,
      "maxBatchSize": "101",
      "authenticationEnabled": true,
      "rudderAccountId": "http-account-1"
    },
    "result": false,
    "err": [
      "maxBatchSize must match pattern \"^([1-9][0-9]{0,1}|100)$\"",
      " must match \"then\" schema"
    ]
  },
  {
    "testTitle": "With invalid api url",
    "config": {
      "apiUrl": "http://23452345.ngrok.io/",
