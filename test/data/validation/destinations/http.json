    },
    "result": false,
    "err": ["supportedMessageTypes.1 must be equal to one of the allowed values"]
  },
  {
    "testTitle": "XML with a single root key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "XML",
      "requestBodyTemplate": "{\"Envelope\": {\"events\": $$.events.{\"event\": event}}}",
      "maxBatchSize": "1",
      "authenticationEnabled": false
    },
    "result": true
  },
  {
    "testTitle": "Reject an empty header key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "headers": [
        {
          "to": "",
          "from": "$$.message.userId"
        }
      ],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["headers.0.to must match pattern \"^(?!\\$)[A-Za-z0-9!#$%&'*+.^_`|~-]{1,100}$\""]
  },
  {
    "testTitle": "Reject an empty query parameter key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "queryParams": [
        {
          "to": "",
          "from": "$$.message.userId"
        }
      ],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["queryParams.0.to must match pattern \"^(?!\\$)[A-Za-z0-9!#$%&'*+.^_`|~\\- ]{1,100}$\""]
  },
  {
    "testTitle": "Reject a header without a key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
