[
  {
    "testTitle": "Nested JSONata body and all request fields",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "pathParams": [
        {
          "path": "$$.events[0].userId"
        }
      ],
      "headers": [
        {
          "to": "Authorization",
          "from": "$string($$.events[0].properties.token)"
        }
      ],
      "queryParams": [
        {
          "to": "source",
          "from": "$$.events[0].context.library.name"
        }
      ],
      "supportedMessageTypes": ["track", "identify", "record"],
      "connectionMode": { "warehouse": "cloud" },
      "isBatchingEnabled": true,
      "maxBatchSize": "1"
    },
    "result": true
  },
  {
    "testTitle": "Maximum batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true,
      "maxBatchSize": "5000"
    },
    "result": true
  },
  {
    "testTitle": "Batch size just above old cap",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true,
      "maxBatchSize": "101"
    },
    "result": true
  },
  {
    "testTitle": "No batching without a size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": false
    },
    "result": true
  },
  {
    "testTitle": "Missing required batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true
    },
    "result": false,
    "err": [" must have required property 'maxBatchSize'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Reject batch size 0",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true,
      "maxBatchSize": "0"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 5001",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true,
      "maxBatchSize": "5001"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 10000",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true,
      "maxBatchSize": "10000"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 01",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "isBatchingEnabled": true,
      "maxBatchSize": "01"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject out-of-range size even without batching",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "5001"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject numeric batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": 5000
    },
    "result": false,
    "err": ["maxBatchSize must be string"]
  },
  {
    "testTitle": "Reject empty body template",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": ""
    },
    "result": false,
    "err": ["requestBodyTemplate must match pattern \"^[\\s\\S]{1,}$\""]
  },
  {
    "testTitle": "Reject unsupported message type",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "supportedMessageTypes": ["track", "bogus"]
    },
    "result": false,
    "err": ["supportedMessageTypes.1 must be equal to one of the allowed values"]
  },
  {
    "testTitle": "Reject non-JSON format",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "XML",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}"
    },
    "result": false,
    "err": ["format must be equal to constant"]
  }
]
