      "requestBodyTemplate": "$$.events",
      "queryParams": [
        {
          "to": "",
          "from": "$$.message.userId"
        }
      ],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["queryParams.0.to must match pattern \"^(?!\\$)[A-Za-z0-9!#$%&'*+.^_`|~\\- ]{1,100}$\""]
  },
  {
    "testTitle": "Reject a header without a key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
