      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["headers.0 must have required property 'to'"]
  },
  {
    "testTitle": "Reject a query parameter without a key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
