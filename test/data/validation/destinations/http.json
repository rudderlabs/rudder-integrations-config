[
  {
    "testTitle": "Nested JSONata body and all request fields with a linked account",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": true,
      "rudderAccountId": "sample-account-id",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "pathParams": [
        {
          "path": "$$.events[0].userId"
        }
      ],
      "headers": [
        {
          "to": "Authorization",
          "from": "$string($$.events[0].properties.token)"
        }
      ],
      "queryParams": [
        {
          "to": "source",
          "from": "$$.events[0].context.library.name"
        }
      ],
      "supportedMessageTypes": ["track", "identify"],
      "connectionMode": {
        "cloud": "cloud"
      },
      "maxBatchSize": "1"
    },
    "result": true
  },
  {
    "testTitle": "Maximum batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "5000"
    },
    "result": true
  },
  {
    "testTitle": "Batch size just above old cap",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "101"
    },
    "result": true
  },
  {
    "testTitle": "Reject JSON without a batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "authenticationEnabled": false
    },
    "result": false,
    "err": [" must have required property 'maxBatchSize'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Reject batch size 0",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "0"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 5001",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "5001"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 10000",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "10000"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 01",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "01"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject numeric batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": 5000
    },
    "result": false,
    "err": ["maxBatchSize must be string"]
  },
  {
    "testTitle": "Reject empty body template",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "",
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["requestBodyTemplate must match pattern \"^[\\s\\S]{1,}$\""]
  },
  {
    "testTitle": "Reject unsupported message type",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "supportedMessageTypes": ["track", "bogus"],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["supportedMessageTypes.1 must be equal to one of the allowed values"]
  },
  {
    "testTitle": "Reject empty supported message types",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "supportedMessageTypes": [],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["supportedMessageTypes must NOT have fewer than 1 items"]
  },
  {
    "testTitle": "Reject record message type",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "authenticationEnabled": false,
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
