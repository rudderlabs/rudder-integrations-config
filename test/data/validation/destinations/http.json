[
  {
    "testTitle": "Nested JSONata body and all request fields",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "pathParams": [
        {
          "path": "$$.events[0].userId"
        }
      ],
      "headers": [
        {
          "to": "Authorization",
          "from": "$string($$.events[0].properties.token)"
        }
      ],
      "queryParams": [
        {
          "to": "source",
          "from": "$$.events[0].context.library.name"
        }
      ],
      "supportedMessageTypes": ["track", "identify"],
      "connectionMode": {
        "warehouse": "cloud"
      },
      "maxBatchSize": "1"
    },
    "result": true
  },
  {
    "testTitle": "Maximum batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "5000"
    },
    "result": true
  },
  {
    "testTitle": "Batch size just above old cap",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "101"
    },
    "result": true
  },
  {
    "testTitle": "Reject JSON without a batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}"
    },
    "result": false,
    "err": [" must have required property 'maxBatchSize'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Reject batch size 0",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "0"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 5001",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "5001"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 10000",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "10000"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject batch size 01",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": "01"
    },
    "result": false,
    "err": ["maxBatchSize must match pattern \"^([1-9][0-9]{0,2}|[1-4][0-9]{3}|5000)$\""]
  },
  {
    "testTitle": "Reject numeric batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "maxBatchSize": 5000
    },
    "result": false,
    "err": ["maxBatchSize must be string"]
  },
  {
    "testTitle": "Reject empty body template",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "",
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["requestBodyTemplate must match pattern \"^[\\s\\S]{1,}$\""]
  },
  {
    "testTitle": "Reject unsupported message type",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "supportedMessageTypes": ["track", "bogus"],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["supportedMessageTypes.1 must be equal to one of the allowed values"]
  },
  {
    "testTitle": "Reject empty supported message types",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "supportedMessageTypes": [],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["supportedMessageTypes must NOT have fewer than 1 items"]
  },
  {
    "testTitle": "Reject record message type",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "supportedMessageTypes": ["track", "record"],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["supportedMessageTypes.1 must be equal to one of the allowed values"]
  },
  {
    "testTitle": "XML with a custom root key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "XML",
      "requestBodyTemplate": "$$.events.{\"event\": event, \"user\": {\"id\": userId}}",
      "xmlRootKey": "Envelope",
      "maxBatchSize": "1"
    },
    "result": true
  },
  {
    "testTitle": "Basic auth with an empty password",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "auth": "basicAuth",
      "username": "user",
      "maxBatchSize": "1"
    },
    "result": true
  },
  {
    "testTitle": "Reject basic auth without a username",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "auth": "basicAuth",
      "maxBatchSize": "1"
    },
    "result": false,
    "err": [" must have required property 'username'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Bearer token auth",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "auth": "bearerTokenAuth",
      "bearerToken": "sample-token",
      "maxBatchSize": "1"
    },
    "result": true
  },
  {
    "testTitle": "Reject bearer token auth without a token",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "auth": "bearerTokenAuth",
      "maxBatchSize": "1"
    },
    "result": false,
    "err": [" must have required property 'bearerToken'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Reject API key auth without a key value",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "auth": "apiKeyAuth",
      "apiKeyName": "x-api-key",
      "maxBatchSize": "1"
    },
    "result": false,
    "err": [" must have required property 'apiKeyValue'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Reject an empty header key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "headers": [
        {
          "to": "",
          "from": "$$.message.userId"
        }
      ],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["headers.0.to must match pattern \"^(?!\\$)[A-Za-z0-9!#$%&'*+.^_`|~-]{1,100}$\""]
  },
  {
    "testTitle": "Reject an empty query parameter key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "format": "JSON",
      "requestBodyTemplate": "$$.events",
      "queryParams": [
        {
          "to": "",
          "from": "$$.message.userId"
        }
      ],
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["queryParams.0.to must match pattern \"^(?!\\$)[A-Za-z0-9!#$%&'*+.^_`|~\\- ]{1,100}$\""]
  },
  {
    "testTitle": "FORM without a batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "[$$.events][0]",
      "format": "FORM"
    },
    "result": true
  },
  {
    "testTitle": "FORM accepts a stored batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "[$$.events][0]",
      "format": "FORM",
      "maxBatchSize": "5000"
    },
    "result": true
  },
  {
    "testTitle": "XML accepts a 5,000-event batch",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "{\"event\": $$.events.{\"id\": messageId}}",
      "format": "XML",
      "maxBatchSize": "5000"
    },
    "result": true
  },
  {
    "testTitle": "XML accepts an empty root key",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "[$$.events][0]",
      "format": "XML",
      "maxBatchSize": "1",
      "xmlRootKey": ""
    },
    "result": true
  },
  {
    "testTitle": "Reject XML without a batch size",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "[$$.events][0]",
      "format": "XML"
    },
    "result": false,
    "err": [" must have required property 'maxBatchSize'", " must match \"then\" schema"]
  },
  {
    "testTitle": "Reject unsupported body format",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "[$$.events][0]",
      "format": "SOAP",
      "maxBatchSize": "1"
    },
    "result": false,
    "err": ["format must be equal to one of the allowed values"]
  },
  {
    "testTitle": "Reject XML root key longer than 100 characters",
    "config": {
      "apiUrl": "https://api.example.com/v1/events",
      "auth": "noAuth",
      "method": "POST",
      "requestBodyTemplate": "[$$.events][0]",
      "format": "XML",
      "maxBatchSize": "1",
      "xmlRootKey": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    "result": false,
    "err": ["xmlRootKey must match pattern \"^(.{0,100})$\""]
  }
]
