  {
    "testTitle": "Valid configuration with comprehensive event mapping and consent",
    "config": {
      "apiKey": "dub_test_key_123",
      "eventMapping": [
        {
          "from": "Purchase",
          "to": "LEAD_CONVERSION"
        },
        {
          "from": "Order Completed",
          "to": "SALES_CONVERSION"
        }
      ],
      "consentManagement": {
        "web": [
          {
            "provider": "custom",
            "resolutionStrategy": "or",
            "consents": [
              {
                "consent": "{{consent.marketing || marketing}}"
              },
              {
                "consent": "analytics"
              }
            ]
          }
        ],
        "ios": [
          {
            "provider": "oneTrust",
            "consents": [
              {
                "consent": "performance"
              }
            ]
          }
        ]
      }
    },
    "result": true
  },
