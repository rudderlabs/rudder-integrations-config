  },
  {
    "testTitle": "With consent management custom provider config invalid provider value",
    "config": {
      "connectionMode": {
        "web": "device"
      },
      "consentManagement": {
        "web": [
          {
            "provider": "dummyProvider"
          }
        ]
      }
