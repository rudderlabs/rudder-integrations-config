      "eventFilteringOption": "disable",
      "consentManagement": {
        "web": [
          {
            "provider": "oneTrust",
            "consents": []
          }
        ]
      }
    },
    "result": false,
    "err": [" must have required property 'connectionMode'"]
  },
  {
    "testTitle": "Invalid config with connectionMode.web set to cloud",
    "config": {
      "whitelistedEvents": [],
      "blacklistedEvents": [],
      "eventFilteringOption": "disable",
      "connectionMode": {
