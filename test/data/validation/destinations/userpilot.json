  {
    "testTitle": "Valid cloud mode configuration",
    "config": {
      "token": "test-token",
      "apiKey": "test-api-key",
      "sdkEndpoint": "wss://analytex.userpilot.io",
      "apiEndpoint": "https://analytex.userpilot.io",
      "connectionMode": {
        "cloud": "cloud"
      }
    },
    "result": true
  },
  {
    "testTitle": "With duplicate consent management providers config - web",
    "config": {
      "token": "dummy-test-value",
      "apiKey": "dummy-test-value",
      "apiEndpoint": "https://analytex.userpilot.io",
      "consentManagement": {
        "web": [
          {
            "provider": "ketch",
            "consents": [
              {
                "consent": "marketing"
              }
            ]
          },
          {
            "provider": "ketch",
            "consents": [
              {
                "consent": "analytics"
              }
            ]
          }
        ]
      }
    },
    "result": false,
    "err": [
      "consentManagement.web Only one consent management block can be configured per provider."
    ]
  },
  {
    "testTitle": "With duplicate consent management providers config - cloud",
    "config": {
      "token": "dummy-test-value",
      "apiKey": "dummy-test-value",
      "apiEndpoint": "https://analytex.userpilot.io",
      "consentManagement": {
        "cloud": [
          {
            "provider": "ketch",
            "consents": [
              {
                "consent": "marketing"
              }
            ]
          },
          {
            "provider": "ketch",
            "consents": [
              {
                "consent": "analytics"
              }
            ]
          }
        ]
      }
    },
    "result": false,
    "err": [
      "consentManagement.cloud Only one consent management block can be configured per provider."
    ]
  },
  {
    "testTitle": "With consent management custom provider config invalid provider value",
    "config": {
      "token": "dummy-test-value",
      "apiKey": "dummy-test-value",
      "apiEndpoint": "https://analytex.userpilot.io",
      "consentManagement": {
        "web": [
          {
            "provider": "dummyProvider"
          }
        ]
      }
    },
    "result": false,
    "err": ["consentManagement.web.0.provider must be equal to one of the allowed values"]
  },
  {
    "testTitle": "With consent management custom provider config and invalid resolutionStrategy value",
    "config": {
      "token": "dummy-test-value",
      "apiKey": "dummy-test-value",
      "apiEndpoint": "https://analytex.userpilot.io",
      "consentManagement": {
        "web": [
          {
            "provider": "custom",
            "resolutionStrategy": "nor"
          }
        ]
      }
    },
    "result": false,
    "err": [
      "consentManagement.web.0.resolutionStrategy must be equal to one of the allowed values",
      "consentManagement.web.0 must match \"then\" schema"
    ]
  },
  {
    "testTitle": "With consent management custom provider config and no resolutionStrategy value",
    "config": {
      "token": "dummy-test-value",
      "apiKey": "dummy-test-value",
      "apiEndpoint": "https://analytex.userpilot.io",
      "consentManagement": {
        "web": [
          {
            "provider": "custom"
          }
        ]
      }
    },
    "result": false,
    "err": [
      "consentManagement.web.0 must have required property 'resolutionStrategy'",
      "consentManagement.web.0 must match \"then\" schema"
    ]
  }
