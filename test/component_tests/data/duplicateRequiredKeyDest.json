{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["accountId", "region"],
    "type": "object",
    "properties": {
      "accountId": {
        "type": "string",
        "pattern": "^(.{1,100})$"
      },
      "region": {
        "type": "string",
        "pattern": "^(.{1,50})$"
      },
      "connectionMode": {
        "type": "object",
        "properties": {
          "cloud": {
            "type": "string",
            "enum": ["cloud"]
          }
        }
      }
    }
  }
}
