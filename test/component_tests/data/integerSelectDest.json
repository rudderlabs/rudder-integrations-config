{
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["numericSelectField", "stringSelectField"],
    "type": "object",
    "properties": {
      "numericSelectField": {
        "type": "integer",
        "enum": [1, 2],
        "default": 1
      },
      "stringSelectField": {
        "type": "string",
        "enum": ["optA", "optB"],
        "default": "optA"
      },
      "connectionMode": {
        "type": "object",
        "properties": {
          "cloud": {
            "type": "string",
            "enum": ["cloud"]
          }
        }
      }
    }
  }
}
